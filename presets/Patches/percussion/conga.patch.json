{
  "format": "lunelle-patch/1",
  "name": "conga",
  "about": "A conga: the hand's knock ringing a skin's modes (which are not a string's), with the slap of the fingers. Around notes 55 to 65",
  "operators": [
    { "name": "hand", "kind": "sine", "fixed": 700, "envelope": "decay 0.004", "level": 0.1, "velocity": 0.5 },
    {
      "name": "skin",
      "kind": "modes",
      "modes": ["at 1 0.28", "at 1.59 0.12 0.4", "at 2.14 0.07 0.2"],
      "drivenBy": ["hand"]
    },
    { "name": "noise1", "kind": "noise", "envelope": "decay 0.025", "velocity": 1 }
  ],
  "out": [{ "op": "skin" }, { "op": "noise1", "level": 0.6 }],
  "filter": { "kind": "lowPass", "cutoff": 4000 },
  "gain": -8,
  "pitchDrop": { "semitones": 1.5, "seconds": 0.03 }
}
