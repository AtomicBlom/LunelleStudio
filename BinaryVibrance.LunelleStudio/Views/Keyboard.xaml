<?xml version="1.0" encoding="utf-8"?>
<!-- Three octaves of piano keys round the bench's octave: pressing one sounds its note, letting go ends it; lit as the
     track the keyboard plays sounds them, those outside the song's scale faded. -->
<ContentControl xmlns="https://github.com/AtomicBlom/Vysara/ui"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                x:Class="BinaryVibrance.LunelleStudio.Views.Keyboard"
                IsTabStop="False">
    <Canvas x:Name="Keys" Width="588" Height="112" HorizontalAlignment="Left" />
</ContentControl>
