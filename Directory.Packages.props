<Project>

  <!-- Central Package Management: versions live here as <PackageVersion>; the projects carry version-less
       <PackageReference> items. The engine's and the audio's own projects, built from their checkouts, take theirs from
       their own repositories. -->

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup Label="Music projects compiled in-process (BinaryVibrance.SirrowStudio.Projects)">
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="4.14.0" />
  </ItemGroup>

  <ItemGroup Label="Tests (TUnit on Microsoft.Testing.Platform + Shouldly assertions)">
    <PackageVersion Include="TUnit" Version="1.74.0" />
    <PackageVersion Include="Shouldly" Version="4.3.0" />
  </ItemGroup>

  <ItemGroup Label="NuGet packaging + SourceLink">
    <PackageVersion Include="Microsoft.SourceLink.GitHub" Version="10.0.401" />
  </ItemGroup>

</Project>
