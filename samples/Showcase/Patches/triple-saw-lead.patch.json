{
  "format": "lunelle-patch/1",
  "name": "triple-saw-lead",
  "about": "A bright, cutting lead: three saws a few cents apart across the middle, and a quiet narrow square an octave up for bite, mono, its filter punched open at each note and settling, with a vibrato that comes in on held notes. Bright opens the filter further",
  "operators": [
    { "name": "saw1", "kind": "saw", "detune": -8, "envelope": "adsr 0.004 0.3 0.8 0.15", "level": 0.35 },
    { "name": "saw2", "kind": "saw", "phase": 0.33, "envelope": "adsr 0.004 0.3 0.8 0.15", "level": 0.35 },
    { "name": "saw3", "kind": "saw", "detune": 8, "phase": 0.66, "envelope": "adsr 0.004 0.3 0.8 0.15", "level": 0.35 },
    { "name": "bite", "kind": "pulse", "ratio": 2, "envelope": "adsr 0.004 0.2 0.5 0.15", "level": 0.12, "pulseWidth": 0.3 }
  ],
  "out": [{ "op": "saw1", "pan": -0.25 }, { "op": "saw2" }, { "op": "saw3", "pan": 0.25 }, { "op": "bite" }],
  "filter": {
    "kind": "lowPass",
    "cutoff": 1600,
    "q": 1.3,
    "keyTrack": 0.5,
    "envelopeOctaves": 1.5,
    "envelope": "adsr 0.003 0.25 0.2 0.15"
  },
  "gain": -10,
  "sends": { "space": 0.2, "echo": 0.18 },
  "vibrato": { "rate": 5.5, "depth": 0.15, "delay": 0.3 },
  "mono": { "glide": 0.02 },
  "macros": [{ "macro": 0, "target": "filterOctaves", "from": -0.5, "to": 1.2 }]
}
