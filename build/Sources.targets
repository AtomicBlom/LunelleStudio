<Project>

  <!--
    Each reference into another repository, by its package id, as a reference to the project in that repository's
    checkout or to the package (build/Sources.props says which):

      <KaldraReference Include="BinaryVibrance.Kaldra.Input" Path="BinaryVibrance.Kaldra.Input\BinaryVibrance.Kaldra.Input.csproj" />                    the engine
      <SirrowReference Include="BinaryVibrance.Sirrow.Sdl"
                       Path="BinaryVibrance.Sirrow.Sdl\BinaryVibrance.Sirrow.Sdl.csproj" />      the audio
      <LunelleReference Include="BinaryVibrance.Lunelle"
                        Path="BinaryVibrance.Lunelle\BinaryVibrance.Lunelle.csproj" />            the synth
      <VysaraReference Include="BinaryVibrance.Vysara" Path="BinaryVibrance.Vysara\BinaryVibrance.Vysara.csproj" />
                                                                                                      the UI library

    Path is its project's path in the checkout (not Project: a ProjectReference keeps a GUID in that). Any other
    metadata (OutputItemType, ReferenceOutputAssembly) goes with it onto the project reference. SourceOnly="true" marks
    a reference only a source build needs: the music generator, which the BinaryVibrance.Lunelle package carries as
    its analyzer.
  -->
  <ItemGroup Condition="'$(KaldraFromSource)' == 'true'">
    <ProjectReference Include="@(KaldraReference->'$(KaldraSource)%(Path)')" />
  </ItemGroup>
  <ItemGroup Condition="'$(KaldraFromSource)' != 'true' and '$(ManagePackageVersionsCentrally)' != 'true'">
    <PackageReference Include="@(KaldraReference)" Exclude="@(KaldraReference->WithMetadataValue('SourceOnly', 'true'))"
                      Version="$(KaldraPackageVersion)" />
  </ItemGroup>
  <ItemGroup Condition="'$(KaldraFromSource)' != 'true' and '$(ManagePackageVersionsCentrally)' == 'true'">
    <PackageReference Include="@(KaldraReference)" Exclude="@(KaldraReference->WithMetadataValue('SourceOnly', 'true'))"
                      VersionOverride="$(KaldraPackageVersion)" />
  </ItemGroup>

  <ItemGroup Condition="'$(SirrowFromSource)' == 'true'">
    <ProjectReference Include="@(SirrowReference->'$(SirrowSource)%(Path)')" />
  </ItemGroup>
  <ItemGroup Condition="'$(SirrowFromSource)' != 'true' and '$(ManagePackageVersionsCentrally)' != 'true'">
    <PackageReference Include="@(SirrowReference)" Exclude="@(SirrowReference->WithMetadataValue('SourceOnly', 'true'))"
                      Version="$(SirrowPackageVersion)" />
  </ItemGroup>
  <ItemGroup Condition="'$(SirrowFromSource)' != 'true' and '$(ManagePackageVersionsCentrally)' == 'true'">
    <PackageReference Include="@(SirrowReference)" Exclude="@(SirrowReference->WithMetadataValue('SourceOnly', 'true'))"
                      VersionOverride="$(SirrowPackageVersion)" />
  </ItemGroup>

  <ItemGroup Condition="'$(LunelleFromSource)' == 'true'">
    <ProjectReference Include="@(LunelleReference->'$(LunelleSource)%(Path)')" />
  </ItemGroup>
  <ItemGroup Condition="'$(LunelleFromSource)' != 'true' and '$(ManagePackageVersionsCentrally)' != 'true'">
    <PackageReference Include="@(LunelleReference)" Exclude="@(LunelleReference->WithMetadataValue('SourceOnly', 'true'))"
                      Version="$(LunellePackageVersion)" />
  </ItemGroup>
  <ItemGroup Condition="'$(LunelleFromSource)' != 'true' and '$(ManagePackageVersionsCentrally)' == 'true'">
    <PackageReference Include="@(LunelleReference)" Exclude="@(LunelleReference->WithMetadataValue('SourceOnly', 'true'))"
                      VersionOverride="$(LunellePackageVersion)" />
  </ItemGroup>

  <ItemGroup Condition="'$(VysaraFromSource)' == 'true'">
    <ProjectReference Include="@(VysaraReference->'$(VysaraSource)%(Path)')" />
  </ItemGroup>
  <ItemGroup Condition="'$(VysaraFromSource)' != 'true' and '$(ManagePackageVersionsCentrally)' != 'true'">
    <PackageReference Include="@(VysaraReference)" Version="$(KaldraVysaraVersion)" />
  </ItemGroup>
  <ItemGroup Condition="'$(VysaraFromSource)' != 'true' and '$(ManagePackageVersionsCentrally)' == 'true'">
    <PackageReference Include="@(VysaraReference)" VersionOverride="$(KaldraVysaraVersion)" />
  </ItemGroup>

  <!--
    The music generator's assembly beside a project's output, where CopyMusicGenerator is true: a project
    lunelle-studio new makes names it there as its analyzer (ProjectTemplate), as it names Sirrow's and Lunelle's.
    From source, the project reference to the generator copies it; from the packages, it is taken out of the
    BinaryVibrance.Lunelle package, which carries it as its analyzer.
  -->
  <ItemGroup Condition="'$(CopyMusicGenerator)' == 'true' and '$(LunelleFromSource)' != 'true'">
    <None Include="$(NuGetPackageRoot)binaryvibrance.lunelle\$(LunellePackageVersion)\analyzers\dotnet\cs\BinaryVibrance.Lunelle.Music.Generator.dll"
          CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

  <!--
    With it, the props that hand a project's music to the generator, and Lunelle's own sounds (its library "lunelle"), so a
    project the studio makes imports them from beside the studio (lunelle-music.props, Library/): from Lunelle's checkout,
    or its package, which carries both.
  -->
  <PropertyGroup Condition="'$(CopyMusicGenerator)' == 'true'">
    <_LunelleMusicRoot Condition="'$(LunelleFromSource)' == 'true'">$(LunelleSource)BinaryVibrance.Lunelle\</_LunelleMusicRoot>
    <_LunelleMusicRoot Condition="'$(LunelleFromSource)' != 'true'">$(NuGetPackageRoot)binaryvibrance.lunelle\$(LunellePackageVersion)\</_LunelleMusicRoot>
  </PropertyGroup>
  <ItemGroup Condition="'$(CopyMusicGenerator)' == 'true'">
    <None Include="$(_LunelleMusicRoot)build\BinaryVibrance.Lunelle.props" Link="lunelle-music.props" CopyToOutputDirectory="PreserveNewest" Visible="false" />
    <None Include="$(_LunelleMusicRoot)Library\**\*" Link="Library\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

</Project>
