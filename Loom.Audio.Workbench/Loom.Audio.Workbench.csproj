<Project Sdk="Microsoft.NET.Sdk">

	<!-- The music workbench: a SUIsei page that plays a song while its code is edited under dotnet watch, rebuilding it
	     and swapping it in on the next bar. Its model and view models need no window; its views are SUIsei XAML. Given a
	     catalog of songs, patches, kits and cues by the app that hosts it; knows nothing of any game. -->
	<Import Project="..\external\SUIsei\build\SUIsei.props" />

	<PropertyGroup>
		<TargetFramework>net11.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
	</PropertyGroup>

	<!-- Packed: it is what a project's workbench extension builds against (IWorkbenchExtension, its context and the
	     workbench it is handed), at the version of the loom-workbench that loads it, and what an app hosting the workbench
	     itself takes. -->
	<PropertyGroup Label="NuGet">
		<PackageId>Loom.Audio.Workbench</PackageId>
		<Description>The music workbench for Loom.Audio.Synth: its model, view models and SUIsei views, with no window of its own; the API a workbench extension is written against.</Description>
		<PackageTags>audio;music;synthesis;workbench;suisei;dotnet</PackageTags>
	</PropertyGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="Loom.Audio.Workbench.Tests" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Loom.Input\Loom.Input.csproj" />
		<ProjectReference Include="..\Loom.Audio.Synth\Loom.Audio.Synth.csproj" />
		<ProjectReference Include="..\external\SUIsei\SUIsei\SUIsei.csproj" />
	</ItemGroup>

	<Import Project="..\external\SUIsei\build\SUIsei.targets" />

</Project>
