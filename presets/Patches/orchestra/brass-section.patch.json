{
  "format": "lunelle-patch/1",
  "name": "brass-section",
  "about": "A brass section: two saws, a little apart from each other, through a filter that opens as each note is blown, further the harder it is played",
  "operators": [
    { "name": "saw1", "kind": "saw", "detune": -6, "envelope": "adsr 0.04 0.2 0.85 0.12", "level": 0.5 },
    { "name": "saw2", "kind": "saw", "detune": 6, "envelope": "adsr 0.04 0.2 0.85 0.12", "level": 0.5 }
  ],
  "out": [{ "op": "saw1", "pan": -0.35 }, { "op": "saw2", "pan": 0.35 }],
  "filter": {
    "kind": "lowPass",
    "cutoff": 450,
    "q": 1.1,
    "keyTrack": 0.5,
    "velocity": 0.4,
    "envelopeOctaves": 2.6,
    "envelope": "adsr 0.06 0.3 0.6 0.15"
  },
  "gain": -4,
  "sends": { "space": 0.3 },
  "vibrato": { "rate": 5, "depth": 0.08, "delay": 0.4 }
}
