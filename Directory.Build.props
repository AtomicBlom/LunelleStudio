<Project>

  <Import Project="$(MSBuildThisFileDirectory)Version.props" />

  <!-- Where the engine, the audio and Vysara come from, for every project here: checkouts, or their packages
       (build/Sources.props). The workbench app imports it itself, before Kaldra's SDK; once is enough. -->
  <Import Project="$(MSBuildThisFileDirectory)build\Sources.props" Condition="'$(_StudioSourcesProps)' == ''" />

  <!-- A project referenced from outside the solution being built (the engine's and the audio's, in their checkouts, and
       samples/HelloSynth) builds in the configuration being built. Left to MSBuild, a solution build unsets it for them
       and they build in Debug, so a Release workbench ran beside a Debug BinaryVibrance.Sirrow.Synth, which a music project built
       in Release then didn't match. -->
  <PropertyGroup>
    <ShouldUnsetParentConfigurationAndPlatform>false</ShouldUnsetParentConfigurationAndPlatform>
  </PropertyGroup>

  <!-- Warnings are errors across the repository's projects, and CI holds them to it. -->
  <PropertyGroup Label="Warnings as errors">
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <PropertyGroup Label="NuGet package metadata (every packable project here)">
    <Version>$(SirrowStudioVersion)</Version>
    <Authors>AtomicBlom</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/AtomicBlom/SirrowStudio</PackageProjectUrl>
    <RepositoryUrl>https://github.com/AtomicBlom/SirrowStudio</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <IncludeSymbols>true</IncludeSymbols>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <!-- SourceLink: embeds the GitHub commit URL in symbols so debuggers can fetch source on demand. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="All" />
  </ItemGroup>

  <!-- Each project's own README.md in its package. PackageReadmeFile alone does not include the file: the SDK wants an
       explicit Pack=true item, or packing fails NU5039 ("readme file does not exist"). -->
  <ItemGroup Condition="Exists('$(MSBuildProjectDirectory)/README.md')">
    <None Include="$(MSBuildProjectDirectory)/README.md" Pack="true" PackagePath="README.md" />
  </ItemGroup>

</Project>
