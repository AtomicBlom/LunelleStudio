<?xml version="1.0" encoding="utf-8"?>
<!--
    The library: the catalog's songs, patches and kits in one list, filtered by the words typed, the one chosen lit. Over
    the view it folds away once something is chosen; Pin keeps it open as a column of its own.
-->
<ContentControl xmlns="https://github.com/AtomicBlom/SUIsei/ui"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:wb="using:Loom.Audio.Workbench"
                xmlns:views="using:Loom.Audio.Workbench.Views"
                x:Class="Loom.Audio.Workbench.Views.CatalogBrowser"
                IsTabStop="False">
    <Border Background="{x:Static views:Theme.Panel}" BorderBrush="{x:Static views:Theme.Line}" BorderThickness="1" CornerRadius="8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="8,8,8,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Filter" FontSize="11" Foreground="{x:Static views:Theme.Faint}" Margin="2,0,0,3" />
                    <TextBox x:Name="Filter" Height="28" />
                </StackPanel>
                <ToggleButton Grid.Column="1" IsChecked="{x:Bind ViewModel.LibraryPinned, Mode=TwoWay}" Margin="6,16,0,0"
                              VerticalAlignment="Bottom" Height="28">
                    <TextBlock Text="{x:Bind views:Display.Pin(ViewModel.LibraryPinned), Mode=OneWay}" FontSize="12" Margin="8,3,8,4" />
                </ToggleButton>
            </Grid>
            <ScrollViewer Grid.Row="1">
                <StackPanel Margin="4,0,14,10">
                    <TextBlock Text="SONGS" FontSize="10" Foreground="{x:Static views:Theme.Faint}" Margin="6,8,0,4" />
                    <ItemsControl ItemsSource="{x:Bind ViewModel.Songs, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="wb:ChoiceViewModel">
                                <ToggleButton IsChecked="{x:Bind IsSelected, Mode=TwoWay}" Visibility="{x:Bind IsVisible, Mode=OneWay}"
                                              HorizontalAlignment="Stretch" Margin="0,0,0,2">
                                    <TextBlock Text="{x:Bind Name}" FontSize="13" Margin="8,3,8,4" />
                                </ToggleButton>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="PATCHES" FontSize="10" Foreground="{x:Static views:Theme.Faint}" Margin="6,12,0,4" />
                    <ItemsControl ItemsSource="{x:Bind ViewModel.Patches, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="wb:ChoiceViewModel">
                                <ToggleButton IsChecked="{x:Bind IsSelected, Mode=TwoWay}" Visibility="{x:Bind IsVisible, Mode=OneWay}"
                                              HorizontalAlignment="Stretch" Margin="0,0,0,2">
                                    <TextBlock Text="{x:Bind Name}" FontSize="13" Margin="8,3,8,4" />
                                </ToggleButton>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="KITS" FontSize="10" Foreground="{x:Static views:Theme.Faint}" Margin="6,12,0,4" />
                    <ItemsControl ItemsSource="{x:Bind ViewModel.Kits, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="wb:ChoiceViewModel">
                                <ToggleButton IsChecked="{x:Bind IsSelected, Mode=TwoWay}" Visibility="{x:Bind IsVisible, Mode=OneWay}"
                                              HorizontalAlignment="Stretch" Margin="0,0,0,2">
                                    <TextBlock Text="{x:Bind Name}" FontSize="13" Margin="8,3,8,4" />
                                </ToggleButton>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</ContentControl>
