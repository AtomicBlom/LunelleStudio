      "exits": [{ "when": "intensity > 0.75", "then": "breach" }, { "when": "intensity < 0.2", "then": "depths" }, { "then": "current" }]
    },
    {
      "name": "breach",
      "about": "The build: the riser and the airy supersaw swept up over a roll that climbs to the drop",
      "bars": 4,
      "chords": "VI | VI | vii | vii",
      "parts": [
        {
          "track": "drums",
          "name": "roll",
          "beat": "sixteenths",
          "rows": {
            "snare": "x... x... x... x... | x.x. x.x. x.x. x.x. | xxxx xxxx xxxx xxxx | 5566 7788 99XX XXXX",
            "kick": "x... .... x... .... | x... .... x... .... | x... x... x... x... | x.x. x.x. x.x. ...."
          }
        },
        { "track": "air", "strum": "quarters", "notes": "D...", "voicing": "triad" },
        { "track": "riser", "line": "quarters", "notes": "1 - - - | - - - - | - - - - | - - - ." },
        { "track": "sub", "line": "quarters", "notes": "1 - - -", "overChords": true }
      ],
      "sweeps": [
        { "track": "air", "macro": "sweep", "from": 0, "to": 1 },
        { "track": "riser", "macro": "sweep", "from": 0, "to": 1 }
