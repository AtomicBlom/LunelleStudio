{
  "format": "lunelle-patch/1",
  "name": "vibraphone",
  "about": "A vibraphone: an aluminium bar tuned so its second mode is two octaves up, ringing long, under its motor's sway",
  "operators": [
    { "name": "mallet", "kind": "sine", "fixed": 500, "envelope": "decay 0.004", "level": 0.1, "velocity": 0.6 },
    {
      "name": "bar",
      "kind": "modes",
      "modes": ["at 1 4", "at 4 1.2 0.25", "at 10 0.35 0.08"],
      "drivenBy": ["mallet"],
      "keyDecay": 0.35
    }
  ],
  "out": [{ "op": "bar" }],
  "gain": -10,
  "sends": { "space": 0.35 },
  "tremolo": { "rate": 5, "depth": 0.3 }
}
