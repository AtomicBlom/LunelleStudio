<Project>

	<!-- Where the engine, the audio and Vysara come from (build/Sources.props): first, since it says which SDK to import -->
	<Import Project="..\build\Sources.props" />

	<!--
		loom-workbench: the music workbench over any music project. Give it a .csproj (or the folder it is in) whose assembly
		names its catalog with [assembly: MusicCatalog(typeof(...))]; it compiles the project with Roslyn, plays it, and
		compiles it again on every save, the song swapped in at the next bar. "loom-workbench new <folder>" makes a project
		to start from. docs/synth.md, section 10, has the rest.
	-->

	<PropertyGroup>
		<UseVulkan>true</UseVulkan>
		<UseDirectX12>false</UseDirectX12>
		<UseWebGPU>false</UseWebGPU>
		<UseVysara>true</UseVysara>
		<UseImGui>false</UseImGui>
	</PropertyGroup>

	<Import Project="$(LoomSource)build\Loom.Sdk\Sdk\Sdk.props" Condition="'$(LoomFromSource)' == 'true'" />
	<Import Project="Sdk.props" Sdk="Loom.Sdk" Version="$(LoomPackageVersion)" Condition="'$(LoomFromSource)' != 'true'" />

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net11.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<AssemblyName>loom-workbench</AssemblyName>
		<RootNamespace>Loom.Audio.Workbench.App</RootNamespace>
		<LoomShaderSourceDir>$(MSBuildProjectDirectory)\Shaders</LoomShaderSourceDir>
		<!-- On the newest .NET installed, so it can load a project (and an extension) that targets a newer one than Loom -->
		<RollForward>LatestMajor</RollForward>
		<!-- The generator beside the app, for a project it makes ("new") to name as its analyzer (build/Sources.targets) -->
		<CopyMusicGenerator>true</CopyMusicGenerator>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\Loom.Audio.Workbench.Projects\Loom.Audio.Workbench.Projects.csproj" />
		<!-- The music's output: SDL 3's, registered in Program -->
		<SirrowReference Include="Loom.Audio.Sdl" Path="Loom.Audio.Sdl\Loom.Audio.Sdl.csproj" />
		<!-- Beside the app, for a project it makes ("new") to reference as its analyzer, as it references the app's Loom -->
		<SirrowReference Include="Loom.Audio.Music.Generator" Path="Loom.Audio.Music.Generator\Loom.Audio.Music.Generator.csproj" SourceOnly="true" />
	</ItemGroup>

	<ItemGroup Condition="'$(Configuration)' == 'Debug'">
		<!-- Vysara's diagnostics endpoint, which RoseMCP's live UI tools reach the window's tree through; Debug only: the
				 switch, and the endpoint itself, which Program starts -->
		<RuntimeHostConfigurationOption Include="Vysara.Diagnostics.Enabled" Value="true" Trim="true" />
		<VysaraReference Include="Vysara.Diagnostics.Endpoint" Path="Vysara.Diagnostics.Endpoint\Vysara.Diagnostics.Endpoint.csproj" />
	</ItemGroup>

	<Import Project="$(LoomSource)build\Loom.Sdk\Sdk\Sdk.targets" Condition="'$(LoomFromSource)' == 'true'" />
	<Import Project="Sdk.targets" Sdk="Loom.Sdk" Version="$(LoomPackageVersion)" Condition="'$(LoomFromSource)' != 'true'" />

</Project>
