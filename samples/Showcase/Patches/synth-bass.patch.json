{
  "format": "lunelle-patch/1",
  "name": "synth-bass",
  "about": "A synth bass: a saw over a square an octave down, through a filter that snaps shut after each note starts",
  "operators": [
    { "name": "saw1", "kind": "saw", "envelope": "adsr 0.003 0.25 0.7 0.08", "level": 0.6 },
    { "name": "pulse1", "kind": "pulse", "ratio": 0.5, "envelope": "adsr 0.003 0.25 0.7 0.08", "level": 0.5 }
  ],
  "out": [{ "op": "saw1" }, { "op": "pulse1" }],
  "filter": {
    "kind": "lowPass",
    "cutoff": 220,
    "q": 1.6,
    "keyTrack": 0.3,
    "velocity": 0.3,
    "envelopeOctaves": 3.2,
    "envelope": "decay 0.22"
  },
  "drive": 0.15,
  "gain": -1,
  "mono": { "glide": 0.02 },
  "macros": [{ "macro": 0, "target": "filterCutoff", "from": 0.6, "to": 2 }]
}
