{
  "format": "lunelle-patch/1",
  "name": "chime",
  "about": "A chime: a bell-like sine whose modulator an octave up dies first, with a quiet twelfth over it, into the space",
  "operators": [
    { "name": "modulator", "kind": "sine", "ratio": 2, "envelope": "decay 0.3" },
    {
      "name": "sine1",
      "kind": "sine",
      "envelope": "decay 0.9",
      "level": 0.5,
      "modulatedBy": [{ "op": "modulator", "index": 1.2 }]
    },
    { "name": "sine2", "kind": "sine", "ratio": 3, "envelope": "decay 0.4", "level": 0.15 }
  ],
  "out": [{ "op": "sine1" }, { "op": "sine2" }],
  "sends": { "space": 0.3 }
}
