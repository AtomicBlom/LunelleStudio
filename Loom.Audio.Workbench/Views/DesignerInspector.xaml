<?xml version="1.0" encoding="utf-8"?>
<!--
    The patch designer's inspector: tabs for the operator chosen, the voice, the macros and the code. Every line is one
    template: a heading, a number on a slider, a choice among options, a switch, or a button. The macros tab ends with
    each macro's live value, as the game would turn it; the code tab shows the C# and copies it.
-->
<ContentControl xmlns="https://github.com/AtomicBlom/Vysara/ui"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:wb="using:Loom.Audio.Workbench"
                xmlns:views="using:Loom.Audio.Workbench.Views"
                x:Class="Loom.Audio.Workbench.Views.DesignerInspector"
                IsTabStop="False">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="8,8,8,6">
            <ToggleButton ToolTipService.ToolTip="Settings of the selected operator" IsChecked="{x:Bind ViewModel.Designer.IsOperatorTab, Mode=TwoWay}" Margin="0,0,3,0" Padding="8,3,8,4">
                <TextBlock Text="Operator" FontSize="12" />
            </ToggleButton>
            <ToggleButton ToolTipService.ToolTip="Voice settings: filter, pitch movement and level" IsChecked="{x:Bind ViewModel.Designer.IsVoiceTab, Mode=TwoWay}" Margin="0,0,3,0" Padding="8,3,8,4">
                <TextBlock Text="Voice" FontSize="12" />
            </ToggleButton>
            <ToggleButton ToolTipService.ToolTip="Macros and the settings each controls" IsChecked="{x:Bind ViewModel.Designer.IsMacrosTab, Mode=TwoWay}" Margin="0,0,3,0" Padding="8,3,8,4">
                <TextBlock Text="Macros" FontSize="12" />
            </ToggleButton>
            <ToggleButton ToolTipService.ToolTip="The patch as C# code" IsChecked="{x:Bind ViewModel.Designer.IsCodeTab, Mode=TwoWay}" Padding="8,3,8,4">
                <TextBlock Text="C#" FontSize="12" />
            </ToggleButton>
        </StackPanel>

        <ScrollViewer Grid.Row="1" Visibility="{x:Bind views:Display.Not(ViewModel.Designer.IsCodeTab), Mode=OneWay}">
            <StackPanel Margin="12,0,16,12">
                <ItemsControl ItemsSource="{x:Bind ViewModel.Designer.Inspector, Mode=OneWay}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="wb:InspectorItemViewModel">
                            <StackPanel>
                                <TextBlock Text="{x:Bind Label}" Visibility="{x:Bind IsHeading}" FontSize="10" Foreground="{x:Static views:Theme.Faint}"
                                           Margin="0,12,0,4" />
                                <Grid Visibility="{x:Bind IsSlider}" Margin="0,1,0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="92" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="70" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{x:Bind Label}" FontSize="12" Foreground="{x:Static views:Theme.Dim}" VerticalAlignment="Center" />
                                    <Slider Grid.Column="1" Minimum="{x:Bind Minimum}" Maximum="{x:Bind Maximum}" StepFrequency="{x:Bind Step}" Height="26"
                                            Value="{x:Bind Position, Mode=TwoWay}" />
                                    <TextBlock Grid.Column="2" Text="{x:Bind ValueText, Mode=OneWay}" FontSize="12" Foreground="{x:Static views:Theme.Ink}"
                                               VerticalAlignment="Center" Margin="8,0,0,0" />
                                </Grid>
                                <StackPanel Visibility="{x:Bind IsChoice}" Margin="0,2,0,2">
                                    <TextBlock Text="{x:Bind Label}" FontSize="12" Foreground="{x:Static views:Theme.Dim}" Margin="0,0,0,2" />
                                    <ItemsControl ItemsSource="{x:Bind Options}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="wb:ChoiceViewModel">
                                                <ToggleButton ToolTipService.ToolTip="{x:Bind views:Display.OptionTip(Name)}" IsChecked="{x:Bind IsSelected, Mode=TwoWay}" Margin="0,0,3,3" Padding="6,2,6,3">
                                                    <TextBlock Text="{x:Bind Name}" FontSize="11" />
                                                </ToggleButton>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                                <ToggleButton ToolTipService.ToolTip="{x:Bind views:Display.ItemTip(Label)}" Visibility="{x:Bind IsToggle}" IsChecked="{x:Bind IsOn, Mode=TwoWay}" HorizontalAlignment="Left" Margin="0,2,0,2" Padding="8,3,8,4">
                                    <TextBlock Text="{x:Bind Label}" FontSize="12" />
                                </ToggleButton>
                                <Button ToolTipService.ToolTip="{x:Bind views:Display.ItemTip(Label)}" Visibility="{x:Bind IsAction}" Command="{x:Bind Command}" HorizontalAlignment="Left" Margin="0,2,0,2" Padding="8,3,8,4">
                                    <TextBlock Text="{x:Bind Label}" FontSize="12" />
                                </Button>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <StackPanel Visibility="{x:Bind ViewModel.Designer.IsMacrosTab, Mode=OneWay}" Margin="0,8,0,0">
                    <TextBlock Text="CURRENT VALUES" FontSize="10" Foreground="{x:Static views:Theme.Faint}" Margin="0,8,0,4" />
                    <ItemsControl ItemsSource="{x:Bind ViewModel.Macros, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="wb:MacroViewModel">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{x:Bind Name}" FontSize="12" Foreground="{x:Static views:Theme.Dim}" Width="70" VerticalAlignment="Center" />
                                    <Slider Minimum="0" Maximum="1" StepFrequency="0.01" Width="200" Height="26" Value="{x:Bind Value, Mode=TwoWay}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="1" Visibility="{x:Bind ViewModel.Designer.IsCodeTab, Mode=OneWay}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="12,0,12,6">
                <Button ToolTipService.ToolTip="Copy the patch's C# to the clipboard" Command="{x:Bind ViewModel.Designer.CopyCommand, Mode=OneWay}" Padding="8,3,8,4">
                    <TextBlock Text="Copy" FontSize="12" />
                </Button>
                <TextBlock Text="{x:Bind ViewModel.CopyStatus, Mode=OneWay}" FontSize="11" Foreground="{x:Static views:Theme.Dim}" Margin="10,0,0,0"
                           VerticalAlignment="Center" />
            </StackPanel>
            <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto">
                <TextBlock Text="{x:Bind ViewModel.Designer.Code, Mode=OneWay}" FontSize="12" Foreground="{x:Static views:Theme.Ink}" Margin="12,0,16,12" />
            </ScrollViewer>
        </Grid>
    </Grid>
</ContentControl>
