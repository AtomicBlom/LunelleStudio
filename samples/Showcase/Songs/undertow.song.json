      "exits": [{ "then": "riptide" }]
    },
    {
      "name": "riptide",
      "about": "The drop: everything, stabs on the off-beats, twice round and on while the intensity holds",
      "bars": 8,
      "chords": "i | i | II | II | VI | VI | vii | vii",
      "parts": [
        {
          "track": "drums",
          "beat": "sixteenths",
          "rows": { "kick": "x... .... ..x. ....", "snare": ".... x..o .o.. x...", "hat-closed": "x.x. x.x. x.x. x.xx" }
        },
        {
          "track": "drums",
          "name": "crash",
          "beat": "eighths",
          "rows": { "crash": "x... .... | .... .... | .... .... | .... .... | x... .... | .... .... | .... .... | .... ...." }
        },
        { "track": "sub", "line": "quarters", "notes": "1 - - -", "overChords": true },
        { "track": "reese", "name": "riff", "line": "eighths", "notes": "1 - - 1 2~ 1 - - | 1 - 3~ 2 1 - 7, -" },
        { "track": "stab", "strum": "sixteenths", "notes": "..D. ..D. ..D. ..DD", "voicing": "triad" },
        { "track": "pluck", "line": "sixteenths", "notes": "1 5 8 5 3 5 8 5 1 5 8 5 3 5 9 5", "overChords": true }
      ],
      "exits": [{ "when": "pass < 2", "then": "riptide" }, { "when": "intensity > 0.75", "then": "riptide" }, { "then": "current" }]
    }
  ]
}
