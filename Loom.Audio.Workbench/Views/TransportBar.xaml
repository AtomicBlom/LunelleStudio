<?xml version="1.0" encoding="utf-8"?>
<!-- The transport: a button per song, play, where the song is, its tempo and scale, and room for an app's own controls. -->
<ContentControl xmlns="https://github.com/AtomicBlom/SUIsei/ui"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                x:Class="Loom.Audio.Workbench.Views.TransportBar"
                IsTabStop="False">
    <StackPanel Orientation="Horizontal">
        <StackPanel x:Name="SongButtons" Orientation="Horizontal" VerticalAlignment="Center" />
        <ToggleButton x:Name="PlayButton" Width="80" Margin="8,0,12,0" VerticalAlignment="Center">
            <TextBlock x:Name="PlayLabel" Text="Play" FontSize="14" HorizontalAlignment="Center" />
        </ToggleButton>
        <TextBlock x:Name="PositionLabel" FontSize="15" VerticalAlignment="Center" Margin="0,0,16,0"
                   Text="{x:Bind ViewModel.PositionText, Mode=OneWay}" />
        <TextBlock x:Name="TempoLabel" FontSize="15" VerticalAlignment="Center" Margin="0,0,16,0"
                   Text="{x:Bind ViewModel.TempoText, Mode=OneWay}" />
        <TextBlock x:Name="ScaleLabel" FontSize="15" VerticalAlignment="Center" Margin="0,0,16,0"
                   Text="{x:Bind ViewModel.ScaleText, Mode=OneWay}" />
        <StackPanel x:Name="ExtrasPanel" Orientation="Horizontal" VerticalAlignment="Center" />
    </StackPanel>
</ContentControl>
