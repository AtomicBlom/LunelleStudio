<?xml version="1.0" encoding="utf-8"?>
<!--
    The workbench: the transport across the top; down the left a rail (the library, and the modes: Arrange, Patch, Kit, Files);
    the mode's view in the middle, with the library over it or pinned beside it, and a failed build's error over its top;
    the cues beside Arrange, the patch designer's inspector beside Patch; the keyboard docked along the bottom; and the command palette over everything when open.
-->
<ContentControl xmlns="https://github.com/AtomicBlom/Vysara/ui"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:views="using:BinaryVibrance.LunelleStudio.Views"
                x:Class="BinaryVibrance.LunelleStudio.Views.WorkbenchLayout"
                IsTabStop="False">
    <ContentControl.Resources>
        <ResourceDictionary>
            <!-- A rail icon: the design's, drawn in a 20 square with round ends -->
            <Style x:Key="RailIcon" TargetType="Path">
                <Setter Property="Width" Value="20" />
                <Setter Property="Height" Value="20" />
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="StrokeThickness" Value="1.6" />
                <Setter Property="StrokeStartLineCap" Value="Round" />
                <Setter Property="StrokeEndLineCap" Value="Round" />
                <Setter Property="StrokeLineJoin" Value="Round" />
            </Style>
        </ResourceDictionary>
    </ContentControl.Resources>
    <Grid MinWidth="960" MinHeight="600" Background="{x:Static views:Theme.Page}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <views:TransportBar x:Name="TransportView" Grid.Row="0" Margin="12,10,12,8" ViewModel="{x:Bind ViewModel}" />

        <Grid Grid.Row="1" Margin="12,0,12,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- The rail -->
            <Border Grid.Column="0" Width="78" Background="{x:Static views:Theme.Panel}" BorderBrush="{x:Static views:Theme.Line}"
                    BorderThickness="1" CornerRadius="8">
                <!-- Each an icon over its name, lit in the accent while it is the one showing -->
                <StackPanel x:Name="RailModes" Margin="5,6,5,6">
                    <ToggleButton ToolTipService.ToolTip="Library: songs, patches and kits" IsChecked="{x:Bind ViewModel.LibraryOpen, Mode=TwoWay}" HorizontalAlignment="Stretch" Padding="0,8,0,6" Margin="0,0,0,10">
                        <StackPanel>
                            <Path Data="M3,4.5 L17,4.5 M3,10 L17,10 M3,15.5 L12,15.5" Style="{StaticResource RailIcon}"
                                  Stroke="{x:Bind views:Display.RailInk(ViewModel.LibraryOpen), Mode=OneWay}" />
                            <TextBlock Text="Library" FontSize="10.5" HorizontalAlignment="Center" Margin="0,3,0,0" />
                        </StackPanel>
                    </ToggleButton>
                    <ToggleButton ToolTipService.ToolTip="Arrange the song's sections, tracks and parts" IsChecked="{x:Bind ViewModel.IsArrange, Mode=TwoWay}" HorizontalAlignment="Stretch" Padding="0,8,0,6" Margin="0,0,0,4">
                        <StackPanel>
                            <Path Data="M3,4 L8,4 A1,1 0 0 1 9,5 L9,7 A1,1 0 0 1 8,8 L3,8 A1,1 0 0 1 2,7 L2,5 A1,1 0 0 1 3,4 Z M12,4 L17,4 A1,1 0 0 1 18,5 L18,7 A1,1 0 0 1 17,8 L12,8 A1,1 0 0 1 11,7 L11,5 A1,1 0 0 1 12,4 Z M3,12 L11,12 A1,1 0 0 1 12,13 L12,15 A1,1 0 0 1 11,16 L3,16 A1,1 0 0 1 2,15 L2,13 A1,1 0 0 1 3,12 Z"
                                  Style="{StaticResource RailIcon}" Stroke="{x:Bind views:Display.RailInk(ViewModel.IsArrange), Mode=OneWay}" />
                            <TextBlock Text="Arrange" FontSize="10.5" HorizontalAlignment="Center" Margin="0,3,0,0" />
                        </StackPanel>
                    </ToggleButton>
                    <ToggleButton ToolTipService.ToolTip="Design the open patch" IsChecked="{x:Bind ViewModel.IsPatch, Mode=TwoWay}" HorizontalAlignment="Stretch" Padding="0,8,0,6" Margin="0,0,0,4">
                        <StackPanel>
                            <Path Data="M6.7,5 A2.2,2.2 0 1 1 2.3,5 A2.2,2.2 0 1 1 6.7,5 Z M6.7,15 A2.2,2.2 0 1 1 2.3,15 A2.2,2.2 0 1 1 6.7,15 Z M17.7,10 A2.2,2.2 0 1 1 13.3,10 A2.2,2.2 0 1 1 17.7,10 Z M6.7,5.6 L13.3,9.2 M6.7,14.4 L13.3,10.8"
                                  Style="{StaticResource RailIcon}" Stroke="{x:Bind views:Display.RailInk(ViewModel.IsPatch), Mode=OneWay}" />
                            <TextBlock Text="Patch" FontSize="10.5" HorizontalAlignment="Center" Margin="0,3,0,0" />
                        </StackPanel>
                    </ToggleButton>
                    <ToggleButton ToolTipService.ToolTip="Play the open kit and sketch beats" IsChecked="{x:Bind ViewModel.IsKit, Mode=TwoWay}" HorizontalAlignment="Stretch" Padding="0,8,0,6" Margin="0,0,0,4">
                        <StackPanel>
                            <Path Data="M3.7,2.5 L7.8,2.5 A1.2,1.2 0 0 1 9,3.7 L9,7.8 A1.2,1.2 0 0 1 7.8,9 L3.7,9 A1.2,1.2 0 0 1 2.5,7.8 L2.5,3.7 A1.2,1.2 0 0 1 3.7,2.5 Z M12.2,2.5 L16.3,2.5 A1.2,1.2 0 0 1 17.5,3.7 L17.5,7.8 A1.2,1.2 0 0 1 16.3,9 L12.2,9 A1.2,1.2 0 0 1 11,7.8 L11,3.7 A1.2,1.2 0 0 1 12.2,2.5 Z M3.7,11 L7.8,11 A1.2,1.2 0 0 1 9,12.2 L9,16.3 A1.2,1.2 0 0 1 7.8,17.5 L3.7,17.5 A1.2,1.2 0 0 1 2.5,16.3 L2.5,12.2 A1.2,1.2 0 0 1 3.7,11 Z M12.2,11 L16.3,11 A1.2,1.2 0 0 1 17.5,12.2 L17.5,16.3 A1.2,1.2 0 0 1 16.3,17.5 L12.2,17.5 A1.2,1.2 0 0 1 11,16.3 L11,12.2 A1.2,1.2 0 0 1 12.2,11 Z"
                                  Style="{StaticResource RailIcon}" Stroke="{x:Bind views:Display.RailInk(ViewModel.IsKit), Mode=OneWay}" />
                            <TextBlock Text="Kit" FontSize="10.5" HorizontalAlignment="Center" Margin="0,3,0,0" />
                        </StackPanel>
                    </ToggleButton>
                    <ToggleButton ToolTipService.ToolTip="View and copy the project's music files" IsChecked="{x:Bind ViewModel.IsFiles, Mode=TwoWay}" HorizontalAlignment="Stretch" Padding="0,8,0,6">
                        <StackPanel>
                            <Path Data="M7,4 C5,4 5,5.5 5,7 C5,8.5 4,10 3,10 C4,10 5,11.5 5,13 C5,14.5 5,16 7,16 M13,4 C15,4 15,5.5 15,7 C15,8.5 16,10 17,10 C16,10 15,11.5 15,13 C15,14.5 15,16 13,16"
                                  Style="{StaticResource RailIcon}" Stroke="{x:Bind views:Display.RailInk(ViewModel.IsFiles), Mode=OneWay}" />
                            <TextBlock Text="Files" FontSize="10.5" HorizontalAlignment="Center" Margin="0,3,0,0" />
                        </StackPanel>
                    </ToggleButton>
                </StackPanel>
            </Border>

            <!-- The library, pinned as a column -->
            <views:CatalogBrowser x:Name="PinnedLibrary" Grid.Column="1" Width="230" Margin="8,0,0,0" ViewModel="{x:Bind ViewModel}"
                                  Visibility="{x:Bind ViewModel.LibraryPinned, Mode=OneWay}" />

            <!-- The mode's view, with the library over it and a failed build's error over its top -->
            <Grid Grid.Column="2" Margin="8,0,0,0">
                <Border Background="{x:Static views:Theme.Panel}" BorderBrush="{x:Static views:Theme.Line}" BorderThickness="1" CornerRadius="8">
                    <Grid>
                        <views:ArrangeView x:Name="Board" ViewModel="{x:Bind ViewModel}" Visibility="{x:Bind ViewModel.IsArrange, Mode=OneWay}" />
                        <views:PatchDesignerView ViewModel="{x:Bind ViewModel}" Visibility="{x:Bind ViewModel.IsPatch, Mode=OneWay}" />
                        <views:KitView ViewModel="{x:Bind ViewModel}" Visibility="{x:Bind ViewModel.IsKit, Mode=OneWay}" />
                        <views:FilesView ViewModel="{x:Bind ViewModel}" Visibility="{x:Bind ViewModel.IsFiles, Mode=OneWay}" />
                    </Grid>
                </Border>
                <views:CatalogBrowser x:Name="FlyoutLibrary" Width="270" HorizontalAlignment="Left" ViewModel="{x:Bind ViewModel}"
                                      Visibility="{x:Bind ViewModel.LibraryFlyout, Mode=OneWay}" />
                <Border VerticalAlignment="Top" Margin="10,10,10,0" Padding="12,8,12,9" CornerRadius="6"
                        Background="{x:Static views:Theme.ErrorSoft}" BorderBrush="{x:Static views:Theme.Error}" BorderThickness="1"
                        Visibility="{x:Bind ViewModel.ErrorOpen, Mode=OneWay}">
                    <StackPanel>
                        <TextBlock Text="{x:Bind ViewModel.Error, Mode=OneWay}" FontSize="13" Foreground="{x:Static views:Theme.Ink}" TextWrapping="Wrap" />
                        <TextBlock Text="The last successful build keeps playing. Fix the error and save. Press Esc to hide this." FontSize="11"
                                   Foreground="{x:Static views:Theme.Dim}" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- The cues beside Arrange -->
            <Border Grid.Column="3" Width="300" Margin="8,0,0,0" Background="{x:Static views:Theme.Panel}" BorderBrush="{x:Static views:Theme.Line}"
                    BorderThickness="1" CornerRadius="8" Visibility="{x:Bind ViewModel.IsArrange, Mode=OneWay}">
                <views:CuePanel ViewModel="{x:Bind ViewModel}" />
            </Border>

            <!-- The patch designer's inspector beside Patch -->
            <Border Grid.Column="3" Width="360" Margin="8,0,0,0" Background="{x:Static views:Theme.Panel}" BorderBrush="{x:Static views:Theme.Line}"
                    BorderThickness="1" CornerRadius="8" Visibility="{x:Bind ViewModel.IsPatch, Mode=OneWay}">
                <views:DesignerInspector ViewModel="{x:Bind ViewModel}" />
            </Border>
        </Grid>

        <views:KeyboardDock Grid.Row="2" Margin="12,0,12,10" ViewModel="{x:Bind ViewModel}" />

        <!-- A patch or kit dragged out of the library, following the pointer, lit while over the board where it adds a track -->
        <Canvas x:Name="DragLayer" Grid.RowSpan="3" IsHitTestVisible="False">
            <Border x:Name="DragGhost" Visibility="Collapsed" Padding="10,5,10,6" CornerRadius="6" BorderThickness="1">
                <TextBlock x:Name="DragText" FontSize="12" />
            </Border>
        </Canvas>

        <views:CommandPalette Grid.RowSpan="3" ViewModel="{x:Bind ViewModel}" Visibility="{x:Bind ViewModel.PaletteOpen, Mode=OneWay}" />
    </Grid>
</ContentControl>
