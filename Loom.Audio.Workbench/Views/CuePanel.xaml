<?xml version="1.0" encoding="utf-8"?>
<!-- The cues: a row each, its name, then a slider from 0 to 1 and its value for a level, or a button per option for a choice. -->
<ContentControl xmlns="https://github.com/AtomicBlom/SUIsei/ui"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:wb="using:Loom.Audio.Workbench"
                xmlns:views="using:Loom.Audio.Workbench.Views"
                x:Class="Loom.Audio.Workbench.Views.CuePanel"
                IsTabStop="False">
    <StackPanel>
        <TextBlock Text="Cues" FontSize="13" Foreground="{x:Static views:Theme.Dim}" Margin="0,0,0,6" />
        <ItemsControl ItemsSource="{x:Bind ViewModel.Cues, Mode=OneWay}">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="wb:CueViewModel">
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="48" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{x:Bind Name}" FontSize="14" Foreground="{x:Static views:Theme.Ink}"
                                   VerticalAlignment="Center" />
                        <Slider Grid.Column="1" Visibility="{x:Bind IsLevel}" Minimum="0" Maximum="1" StepFrequency="0.01" Height="32"
                                Value="{x:Bind Value, Mode=TwoWay}" />
                        <TextBlock Grid.Column="2" Visibility="{x:Bind IsLevel}" Text="{x:Bind views:Display.Fixed(Value), Mode=OneWay}"
                                   FontSize="13" Foreground="{x:Static views:Theme.Dim}" VerticalAlignment="Center" Margin="8,0,0,0" />
                        <ItemsControl Grid.Column="1" Grid.ColumnSpan="2" Visibility="{x:Bind IsChoice}" ItemsSource="{x:Bind Options}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="wb:ChoiceViewModel">
                                    <ToggleButton IsChecked="{x:Bind IsSelected, Mode=TwoWay}" Margin="0,0,4,4">
                                        <TextBlock Text="{x:Bind Name}" FontSize="13" Margin="8,3,8,4" HorizontalAlignment="Center" />
                                    </ToggleButton>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</ContentControl>
