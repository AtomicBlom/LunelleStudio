<Project Sdk="Microsoft.NET.Sdk">

  <!-- The workbench's tests: its view models and edits (Loom.Audio.Workbench), music projects compiled in-process
       (Loom.Audio.Workbench.Projects), and its extensions. -->
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- TUnit runs on Microsoft.Testing.Platform, whose source generator emits the executable entry point. -->
    <OutputType>Exe</OutputType>
    <!-- The generator beside the tests, where the projects MusicProjectTests makes name it (build/Sources.targets) -->
    <CopyMusicGenerator>true</CopyMusicGenerator>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="TUnit" />
    <PackageReference Include="Shouldly" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="TUnit.Core" />
    <Using Include="Shouldly" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Loom.Audio.Workbench\Loom.Audio.Workbench.csproj" />
    <ProjectReference Include="..\Loom.Audio.Workbench.Projects\Loom.Audio.Workbench.Projects.csproj" />
    <SirrowReference Include="Loom.Audio.Music.Generator" Path="Loom.Audio.Music.Generator\Loom.Audio.Music.Generator.csproj" SourceOnly="true" />
    <ProjectReference Include="..\samples\HelloSynth\HelloSynth.csproj" />
    <!-- The Vysara adapter, whose input layer WorkbenchFocusTests drives the workbench's keys through -->
    <LoomReference Include="Loom.UI.Vysara" Path="Loom.UI.Vysara\Loom.UI.Vysara.csproj" />
  </ItemGroup>

  <!-- The Sirrow checkout this build took the audio from ("none" for its packages), read back by the tests that make a
       music project referencing Loom.Audio.Synth's project (MusicProjectTests.SynthProject) -->
  <ItemGroup>
    <AssemblyMetadata Include="SirrowSource" Value="$(SirrowSource)" />
  </ItemGroup>

</Project>
