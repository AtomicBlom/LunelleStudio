<?xml version="1.0" encoding="utf-8"?>
<!--
    Kit: the kit chosen, a pad per piece (the keyboard's keys play the pieces too); and the beat sketcher, a bar of
    sixteenths per piece, a click turning a step to a hit, an accent, a ghost note or off, looped through the sequencer
    and copied as the Beat.Sixteenths a song would place.
-->
<ContentControl xmlns="https://github.com/AtomicBlom/Vysara/ui"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:wb="using:BinaryVibrance.SirrowStudio"
                xmlns:views="using:BinaryVibrance.SirrowStudio.Views"
                x:Class="BinaryVibrance.SirrowStudio.Views.KitView"
                IsTabStop="False">
    <ScrollViewer>
        <StackPanel Margin="12,10,16,12">
            <TextBlock Text="{x:Bind ViewModel.DockLabel, Mode=OneWay}" FontSize="16" Foreground="{x:Static views:Theme.Ink}" Margin="0,0,0,10" />
            <TextBlock Text="Select a kit in the library." FontSize="13" Foreground="{x:Static views:Theme.Dim}"
                       Visibility="{x:Bind views:Display.NoneChosen(ViewModel.SelectedKit), Mode=OneWay}" />
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{x:Bind ViewModel.Pads, Mode=OneWay}" Margin="0,0,0,14">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="wb:PadViewModel">
                            <Button ToolTipService.ToolTip="{x:Bind views:Display.PadTip(Piece)}" Command="{x:Bind Hit}" Width="120" Height="84" Margin="0,0,8,0">
                                <TextBlock Text="{x:Bind Piece}" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <StackPanel Visibility="{x:Bind views:Display.Chosen(ViewModel.SelectedKit), Mode=OneWay}">
                <StackPanel Orientation="Horizontal" Margin="0,4,0,8">
                    <TextBlock Text="BEAT SKETCHER" FontSize="10" Foreground="{x:Static views:Theme.Faint}" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <ToggleButton ToolTipService.ToolTip="Play the sketch in a loop" IsChecked="{x:Bind ViewModel.Sketch.IsLooping, Mode=TwoWay}" Margin="0,0,6,0" Padding="8,3,8,4">
                        <TextBlock Text="Loop" FontSize="12" />
                    </ToggleButton>
                    <Button ToolTipService.ToolTip="Clear the sketch" Command="{x:Bind ViewModel.Sketch.ClearCommand, Mode=OneWay}" Margin="0,0,6,0" Padding="8,3,8,4">
                        <TextBlock Text="Clear" FontSize="12" />
                    </Button>
                    <Button ToolTipService.ToolTip="Copy the sketch as a beat for a song file" Command="{x:Bind ViewModel.Sketch.CopyCommand, Mode=OneWay}" Margin="0,0,10,0" Padding="8,3,8,4">
                        <TextBlock Text="Copy beat" FontSize="12" />
                    </Button>
                    <TextBlock Text="Tempo" FontSize="12" Foreground="{x:Static views:Theme.Dim}" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <Slider Minimum="60" Maximum="200" StepFrequency="1" Width="140" Height="26" Value="{x:Bind ViewModel.Sketch.Tempo, Mode=TwoWay}" />
                    <TextBlock Text="{x:Bind ViewModel.CopyStatus, Mode=OneWay}" FontSize="11" Foreground="{x:Static views:Theme.Dim}"
                               VerticalAlignment="Center" Margin="10,0,0,0" />
                </StackPanel>
                <TextBlock Text="Click a step to cycle it: x hit, X accent, o ghost note, off." FontSize="11"
                           Foreground="{x:Static views:Theme.Faint}" Margin="0,0,0,6" />
                <ItemsControl ItemsSource="{x:Bind ViewModel.Sketch.Rows, Mode=OneWay}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="wb:BeatRowViewModel">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                <TextBlock Text="{x:Bind Name}" Width="90" FontSize="12" Foreground="{x:Static views:Theme.Dim}" VerticalAlignment="Center" />
                                <ItemsControl ItemsSource="{x:Bind Steps}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="wb:BeatStepViewModel">
                                            <Button ToolTipService.ToolTip="Click to cycle: hit, accent, ghost note, off" Command="{x:Bind Cycle}" Margin="{x:Bind views:Display.StepGap(IsBeat)}">
                                                <Border Width="24" Height="22" CornerRadius="3" Background="{x:Bind views:Display.Step(Value), Mode=OneWay}"
                                                        BorderBrush="{x:Bind views:Display.Now(IsNow), Mode=OneWay}" BorderThickness="1">
                                                    <TextBlock Text="{x:Bind Text, Mode=OneWay}" FontSize="11" Foreground="{x:Static views:Theme.AccentInk}"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="{x:Bind ViewModel.Sketch.Code, Mode=OneWay}" FontSize="12" Foreground="{x:Static views:Theme.Ink}" Margin="0,10,0,0" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</ContentControl>
