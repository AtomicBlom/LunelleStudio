<?xml version="1.0" encoding="utf-8"?>
<!-- Two octaves of piano keys from the bench's octave: pressing one sounds its note on the bench, letting go ends it. -->
<ContentControl xmlns="https://github.com/AtomicBlom/SUIsei/ui"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                x:Class="Loom.Audio.Workbench.Views.Keyboard"
                IsTabStop="False">
    <Canvas x:Name="Keys" Width="420" Height="112" HorizontalAlignment="Left" />
</ContentControl>
