<?xml version="1.0" encoding="utf-8"?>
<!--
    The library: the catalog's songs, patches and kits as lists under their kinds, each row its kind's icon and its name,
    filtered by the words typed, the one chosen lit. A click opens a row; a list reached with Tab takes the arrows and Enter,
    while a click gives the keys back to the workbench (WorkbenchFocus). A new song or patch is made from its kind's +. Under them, for a project of
    files alone, the presets: a click plays one on the keys, its add copies it into the project (open, once it has it). Over the view it folds away once something is chosen; Pin keeps it open as a column of its own.
-->
<ContentControl xmlns="https://github.com/AtomicBlom/Vysara/ui"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:wb="using:BinaryVibrance.LunelleStudio"
                xmlns:views="using:BinaryVibrance.LunelleStudio.Views"
                x:Class="BinaryVibrance.LunelleStudio.Views.CatalogBrowser"
                IsTabStop="False">
    <Border Background="{x:Static views:Theme.PanelFace}" BorderBrush="{x:Static views:Theme.Line}" BorderThickness="1" CornerRadius="8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="8,8,8,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Filter" FontSize="11" Foreground="{x:Static views:Theme.Faint}" Margin="2,0,0,3" />
                    <TextBox x:Name="Filter" Height="28" ToolTipService.ToolTip="Show only items whose names contain every word typed" />
                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                        <ToggleButton IsChecked="{x:Bind ViewModel.FilterSongs, Mode=TwoWay}" Margin="0,0,3,3" Padding="6,1,6,2" ToolTipService.ToolTip="Show songs (with any other kinds ticked); none ticked shows every kind">
                            <TextBlock Text="songs" FontSize="11" />
                        </ToggleButton>
                        <ToggleButton IsChecked="{x:Bind ViewModel.FilterPatches, Mode=TwoWay}" Margin="0,0,3,3" Padding="6,1,6,2" ToolTipService.ToolTip="Show patches">
                            <TextBlock Text="patches" FontSize="11" />
                        </ToggleButton>
                        <ToggleButton IsChecked="{x:Bind ViewModel.FilterKits, Mode=TwoWay}" Margin="0,0,3,3" Padding="6,1,6,2" ToolTipService.ToolTip="Show kits">
                            <TextBlock Text="kits" FontSize="11" />
                        </ToggleButton>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <ToggleButton IsChecked="{x:Bind ViewModel.FilterPatterns, Mode=TwoWay}" Margin="0,0,3,3" Padding="6,1,6,2" ToolTipService.ToolTip="Show patterns">
                            <TextBlock Text="patterns" FontSize="11" />
                        </ToggleButton>
                        <ToggleButton IsChecked="{x:Bind ViewModel.FilterCues, Mode=TwoWay}" Margin="0,0,3,3" Padding="6,1,6,2" ToolTipService.ToolTip="Show cues">
                            <TextBlock Text="cues" FontSize="11" />
                        </ToggleButton>
                        <ToggleButton IsChecked="{x:Bind ViewModel.FilterSounds, Mode=TwoWay}" Margin="0,0,3,3" Padding="6,1,6,2" ToolTipService.ToolTip="Show Lunelle&apos;s sounds">
                            <TextBlock Text="sounds" FontSize="11" />
                        </ToggleButton>
                    </StackPanel>
                </StackPanel>
                <ToggleButton Grid.Column="1" IsChecked="{x:Bind ViewModel.LibraryPinned, Mode=TwoWay}" Margin="6,16,0,0"
                              VerticalAlignment="Top" Height="28" Padding="8,3,8,4" ToolTipService.ToolTip="Pin the library open beside the view">
                    <TextBlock Text="{x:Bind views:Display.Pin(ViewModel.LibraryPinned), Mode=OneWay}" FontSize="12" />
                </ToggleButton>
            </Grid>
            <ScrollViewer Grid.Row="1">
                <StackPanel Margin="4,0,14,10">
                    <StackPanel Visibility="{x:Bind ViewModel.SongsShown, Mode=OneWay}">
                    <Grid Margin="6,10,4,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Path Data="M8,15.5 A2.5,2.5 0 1 1 3,15.5 A2.5,2.5 0 1 1 8,15.5 Z M17,13.5 A2.5,2.5 0 1 1 12,13.5 A2.5,2.5 0 1 1 17,13.5 Z M8,15.5 L8,4.5 L17,2.5 L17,13.5 M8,8 L17,6" Width="12" Height="12" Stretch="Uniform" Stroke="{x:Static views:Theme.Faint}" StrokeThickness="1.4"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="SONGS" FontSize="10" Foreground="{x:Static views:Theme.Faint}" Margin="6,0,0,0" VerticalAlignment="Center" />
                        <Button x:Name="NewSong" Grid.Column="2" Padding="7,1,7,2" ToolTipService.ToolTip="New song">
                            <TextBlock Text="+" FontSize="12" />
                        </Button>
                    </Grid>
                    <ListView x:Name="SongList" ItemsSource="{x:Bind ViewModel.Songs, Mode=OneWay}" IsItemClickEnabled="True">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="wb:ChoiceViewModel">
                                <StackPanel Tag="{x:Bind Self}">
                                    <Button Visibility="{x:Bind ShowsFolder, Mode=OneWay}" Command="{x:Bind FoldCommand}" Padding="4,0,8,1" Margin="0,4,0,2" HorizontalAlignment="Left"
                                            ToolTipService.ToolTip="Fold this folder away, or open it">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{x:Bind FolderGlyph, Mode=OneWay}" FontSize="11" Foreground="{x:Static views:Theme.Faint}" VerticalAlignment="Center" />
                                            <TextBlock Text="{x:Bind Folder}" FontSize="11" Foreground="{x:Static views:Theme.Dim}" Margin="5,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <StackPanel Orientation="Horizontal" Visibility="{x:Bind IsVisible, Mode=OneWay}" Margin="{x:Bind views:Display.Indent(Folder)}">
                                        <Path Data="M8,15.5 A2.5,2.5 0 1 1 3,15.5 A2.5,2.5 0 1 1 8,15.5 Z M17,13.5 A2.5,2.5 0 1 1 12,13.5 A2.5,2.5 0 1 1 17,13.5 Z M8,15.5 L8,4.5 L17,2.5 L17,13.5 M8,8 L17,6" Width="13" Height="13" Stretch="Uniform" Stroke="{x:Static views:Theme.Dim}" StrokeThickness="1.4"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" VerticalAlignment="Center" />
                                        <TextBlock Text="{x:Bind Leaf}" FontSize="13" Margin="8,0,0,0" VerticalAlignment="Center" ToolTipService.ToolTip="{x:Bind Name}" />
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    </StackPanel>
                    <StackPanel Visibility="{x:Bind ViewModel.PatchesShown, Mode=OneWay}">
                    <Grid Margin="6,10,4,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Path Data="M6.7,5 A2.2,2.2 0 1 1 2.3,5 A2.2,2.2 0 1 1 6.7,5 Z M6.7,15 A2.2,2.2 0 1 1 2.3,15 A2.2,2.2 0 1 1 6.7,15 Z M17.7,10 A2.2,2.2 0 1 1 13.3,10 A2.2,2.2 0 1 1 17.7,10 Z M6.7,5.6 L13.3,9.2 M6.7,14.4 L13.3,10.8" Width="12" Height="12" Stretch="Uniform" Stroke="{x:Static views:Theme.Faint}" StrokeThickness="1.4"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="PATCHES" FontSize="10" Foreground="{x:Static views:Theme.Faint}" Margin="6,0,0,0" VerticalAlignment="Center" />
                        <Button x:Name="NewPatch" Grid.Column="2" Padding="7,1,7,2" ToolTipService.ToolTip="New patch: blank, or a copy of the open patch">
                            <TextBlock Text="+" FontSize="12" />
                        </Button>
                    </Grid>
                    <ListView x:Name="PatchList" ItemsSource="{x:Bind ViewModel.Patches, Mode=OneWay}" IsItemClickEnabled="True">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="wb:ChoiceViewModel">
                                <StackPanel Tag="{x:Bind Self}">
                                    <Button Visibility="{x:Bind ShowsFolder, Mode=OneWay}" Command="{x:Bind FoldCommand}" Padding="4,0,8,1" Margin="0,4,0,2" HorizontalAlignment="Left"
                                            ToolTipService.ToolTip="Fold this folder away, or open it">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{x:Bind FolderGlyph, Mode=OneWay}" FontSize="11" Foreground="{x:Static views:Theme.Faint}" VerticalAlignment="Center" />
                                            <TextBlock Text="{x:Bind Folder}" FontSize="11" Foreground="{x:Static views:Theme.Dim}" Margin="5,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <StackPanel Orientation="Horizontal" Visibility="{x:Bind IsVisible, Mode=OneWay}" Margin="{x:Bind views:Display.Indent(Folder)}">
                                        <Path Data="M6.7,5 A2.2,2.2 0 1 1 2.3,5 A2.2,2.2 0 1 1 6.7,5 Z M6.7,15 A2.2,2.2 0 1 1 2.3,15 A2.2,2.2 0 1 1 6.7,15 Z M17.7,10 A2.2,2.2 0 1 1 13.3,10 A2.2,2.2 0 1 1 17.7,10 Z M6.7,5.6 L13.3,9.2 M6.7,14.4 L13.3,10.8" Width="13" Height="13" Stretch="Uniform" Stroke="{x:Static views:Theme.Dim}" StrokeThickness="1.4"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" VerticalAlignment="Center" />
                                        <TextBlock Text="{x:Bind Leaf}" FontSize="13" Margin="8,0,0,0" VerticalAlignment="Center" ToolTipService.ToolTip="{x:Bind Name}" />
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    </StackPanel>
                    <StackPanel Visibility="{x:Bind ViewModel.KitsShown, Mode=OneWay}">
                    <Grid Margin="6,10,4,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Path Data="M2.5,2.5 L9,2.5 L9,9 L2.5,9 Z M11,2.5 L17.5,2.5 L17.5,9 L11,9 Z M2.5,11 L9,11 L9,17.5 L2.5,17.5 Z M11,11 L17.5,11 L17.5,17.5 L11,17.5 Z" Width="12" Height="12" Stretch="Uniform" Stroke="{x:Static views:Theme.Faint}" StrokeThickness="1.4"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="KITS" FontSize="10" Foreground="{x:Static views:Theme.Faint}" Margin="6,0,0,0" VerticalAlignment="Center" />
                    </Grid>
                    <ListView x:Name="KitList" ItemsSource="{x:Bind ViewModel.Kits, Mode=OneWay}" IsItemClickEnabled="True">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="wb:ChoiceViewModel">
                                <StackPanel Tag="{x:Bind Self}">
                                    <Button Visibility="{x:Bind ShowsFolder, Mode=OneWay}" Command="{x:Bind FoldCommand}" Padding="4,0,8,1" Margin="0,4,0,2" HorizontalAlignment="Left"
                                            ToolTipService.ToolTip="Fold this folder away, or open it">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{x:Bind FolderGlyph, Mode=OneWay}" FontSize="11" Foreground="{x:Static views:Theme.Faint}" VerticalAlignment="Center" />
                                            <TextBlock Text="{x:Bind Folder}" FontSize="11" Foreground="{x:Static views:Theme.Dim}" Margin="5,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <StackPanel Orientation="Horizontal" Visibility="{x:Bind IsVisible, Mode=OneWay}" Margin="{x:Bind views:Display.Indent(Folder)}">
                                        <Path Data="M2.5,2.5 L9,2.5 L9,9 L2.5,9 Z M11,2.5 L17.5,2.5 L17.5,9 L11,9 Z M2.5,11 L9,11 L9,17.5 L2.5,17.5 Z M11,11 L17.5,11 L17.5,17.5 L11,17.5 Z" Width="13" Height="13" Stretch="Uniform" Stroke="{x:Static views:Theme.Dim}" StrokeThickness="1.4"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" VerticalAlignment="Center" />
                                        <TextBlock Text="{x:Bind Leaf}" FontSize="13" Margin="8,0,0,0" VerticalAlignment="Center" ToolTipService.ToolTip="{x:Bind Name}" />
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    </StackPanel>
                    <StackPanel Visibility="{x:Bind ViewModel.PatternsShown, Mode=OneWay}">
                        <Grid Margin="6,10,4,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Path Data="M2,4 L18,4 M2,10 L18,10 M2,16 L18,16 M5,2 L5,6 M11,8 L11,12 M15,14 L15,18" Width="12" Height="12" Stretch="Uniform" Stroke="{x:Static views:Theme.Faint}" StrokeThickness="1.4"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="PATTERNS" FontSize="10" Foreground="{x:Static views:Theme.Faint}" Margin="6,0,0,0" VerticalAlignment="Center" />
                        </Grid>
                        <TextBlock Text="Drag one onto a part in Arrange to play it there, or onto a lane for a new part; Shift drops a copy. Or choose a part, and use." FontSize="11" Foreground="{x:Static views:Theme.Faint}"
                                   TextWrapping="Wrap" Margin="8,0,6,4" />
                        <ListView x:Name="PatternList" ItemsSource="{x:Bind ViewModel.LibraryPatterns, Mode=OneWay}">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="wb:PatternEntryViewModel">
                                    <StackPanel Tag="{x:Bind Self}">
                                        <Button Visibility="{x:Bind ShowsFolder, Mode=OneWay}" Command="{x:Bind FoldCommand}" Padding="4,0,8,1" Margin="0,4,0,2" HorizontalAlignment="Left"
                                                ToolTipService.ToolTip="Fold this folder away, or open it">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{x:Bind FolderGlyph, Mode=OneWay}" FontSize="11" Foreground="{x:Static views:Theme.Faint}" VerticalAlignment="Center" />
                                                <TextBlock Text="{x:Bind Folder}" FontSize="11" Foreground="{x:Static views:Theme.Dim}" Margin="5,0,0,0" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                        <Grid Visibility="{x:Bind IsVisible, Mode=OneWay}" Margin="{x:Bind views:Display.Indent(Folder)}" Opacity="{x:Bind Fit, Mode=OneWay}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{x:Bind Leaf}" FontSize="13" Margin="8,0,6,0" VerticalAlignment="Center" ToolTipService.ToolTip="{x:Bind Tip, Mode=OneWay}" />
                                            <Button Grid.Column="1" Command="{x:Bind UseCommand}" Padding="7,1,7,2" VerticalAlignment="Center"
                                                    ToolTipService.ToolTip="Play this pattern in the part chosen, in place of its notes">
                                                <TextBlock Text="use" FontSize="11" />
                                            </Button>
                                        </Grid>
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                    <StackPanel Visibility="{x:Bind ViewModel.CuesShown, Mode=OneWay}">
                        <Grid Margin="6,10,4,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Path Data="M2,15 L6,9 L10,12 L14,5 L18,8" Width="12" Height="12" Stretch="Uniform" Stroke="{x:Static views:Theme.Faint}" StrokeThickness="1.4"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="CUES" FontSize="10" Foreground="{x:Static views:Theme.Faint}" Margin="6,0,0,0" VerticalAlignment="Center" />
                            <Button x:Name="NewCue" Grid.Column="2" Padding="7,1,7,2" ToolTipService.ToolTip="New cue: a level or a choice, imported into this song">
                                <TextBlock Text="+" FontSize="12" />
                            </Button>
                        </Grid>
                        <TextBlock Text="Ticked: the song imports it, and the strip shows it." FontSize="11" Foreground="{x:Static views:Theme.Faint}"
                                   TextWrapping="Wrap" Margin="8,0,6,4" />
                        <ListView x:Name="CueList" ItemsSource="{x:Bind ViewModel.ProjectCues, Mode=OneWay}">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="wb:CueEntryViewModel">
                                    <Grid Tag="{x:Bind Self}" ToolTipService.ToolTip="{x:Bind About}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <CheckBox IsChecked="{x:Bind IsImported, Mode=TwoWay}" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="6,0,6,0" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind Id}" FontSize="13" VerticalAlignment="Center" />
                                            <TextBlock Text="{x:Bind Kind}" FontSize="10" Foreground="{x:Static views:Theme.Faint}" Margin="6,1,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <Button Grid.Column="2" Command="{x:Bind MenuCommand}" Padding="7,1,7,2" VerticalAlignment="Center"
                                                ToolTipService.ToolTip="Rename or delete this cue, in every song">
                                            <TextBlock Text="…" FontSize="11" />
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                    <StackPanel Visibility="{x:Bind ViewModel.SoundsShown, Mode=OneWay}">
                        <Grid Margin="6,16,4,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Path Data="M10,2 L12.4,7.2 L18,7.8 L13.8,11.6 L15,17.2 L10,14.3 L5,17.2 L6.2,11.6 L2,7.8 L7.6,7.2 Z" Width="12" Height="12" Stretch="Uniform" Stroke="{x:Static views:Theme.Faint}" StrokeThickness="1.4"
                                  StrokeLineJoin="Round" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="LUNELLE'S SOUNDS" FontSize="10" Foreground="{x:Static views:Theme.Faint}" Margin="6,0,0,0" VerticalAlignment="Center" />
                        </Grid>
                        <TextBlock Text="Lunelle's library (lunelle:…). Click one to play it on the keys; add makes a sound of this project's based on it, to change without copying." FontSize="11" Foreground="{x:Static views:Theme.Faint}"
                                   TextWrapping="Wrap" Margin="8,0,6,4" />
                        <TextBlock Text="{x:Bind ViewModel.PresetAbout, Mode=OneWay}" FontSize="11" Foreground="{x:Static views:Theme.Dim}"
                                   TextWrapping="Wrap" Margin="8,0,6,6" />
                        <ListView x:Name="PresetList" ItemsSource="{x:Bind ViewModel.Presets, Mode=OneWay}" IsItemClickEnabled="True">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="wb:PresetViewModel">
                                    <Grid Tag="{x:Bind Self}" Visibility="{x:Bind IsVisible, Mode=OneWay}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Path Visibility="{x:Bind IsPatch}" Data="M6.7,5 A2.2,2.2 0 1 1 2.3,5 A2.2,2.2 0 1 1 6.7,5 Z M6.7,15 A2.2,2.2 0 1 1 2.3,15 A2.2,2.2 0 1 1 6.7,15 Z M17.7,10 A2.2,2.2 0 1 1 13.3,10 A2.2,2.2 0 1 1 17.7,10 Z M6.7,5.6 L13.3,9.2 M6.7,14.4 L13.3,10.8" Width="13" Height="13" Stretch="Uniform" Stroke="{x:Static views:Theme.Dim}" StrokeThickness="1.4"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" VerticalAlignment="Center" />
                                        <Path Visibility="{x:Bind IsKit}" Data="M2.5,2.5 L9,2.5 L9,9 L2.5,9 Z M11,2.5 L17.5,2.5 L17.5,9 L11,9 Z M2.5,11 L9,11 L9,17.5 L2.5,17.5 Z M11,11 L17.5,11 L17.5,17.5 L11,17.5 Z" Width="13" Height="13" Stretch="Uniform" Stroke="{x:Static views:Theme.Dim}" StrokeThickness="1.4"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,6,0" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind Name}" FontSize="13" VerticalAlignment="Center" />
                                            <TextBlock Text="{x:Bind Category}" FontSize="10" Foreground="{x:Static views:Theme.Faint}" Margin="6,1,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <Button Grid.Column="2" Command="{x:Bind AddCommand}" Padding="7,1,7,2" VerticalAlignment="Center"
                                                ToolTipService.ToolTip="{x:Bind AddTip, Mode=OneWay}">
                                            <TextBlock Text="{x:Bind AddText, Mode=OneWay}" FontSize="11" />
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</ContentControl>
