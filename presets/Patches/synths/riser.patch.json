{
  "format": "lunelle-patch/1",
  "name": "riser",
  "about": "A riser: noise through a narrow band that Sweep carries up five octaves as it grows, to the end of a build",
  "operators": [{ "name": "noise1", "kind": "noise", "envelope": "adsr 0.2 0.2 1 0.05", "level": 0.5 }],
  "out": [{ "op": "noise1" }],
  "filter": { "kind": "bandPass", "cutoff": 250, "q": 2.5 },
  "gain": 4,
  "sends": { "space": 0.4 },
  "macros": [
    { "macro": 2, "target": "filterOctaves", "from": 0, "to": 5 },
    { "macro": 2, "target": "gain", "from": 0.15, "to": 1 }
  ]
}
