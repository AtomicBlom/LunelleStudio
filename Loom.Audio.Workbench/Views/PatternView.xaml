<?xml version="1.0" encoding="utf-8"?>
<!-- The chosen part as a grid: a row per pitch or piece, its notes as bars, a line per bar, a playhead. Read-only: music is edited in code. -->
<ContentControl xmlns="https://github.com/AtomicBlom/SUIsei/ui"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                x:Class="Loom.Audio.Workbench.Views.PatternView"
                IsTabStop="False">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock x:Name="TitleLabel" Grid.Row="0" FontSize="13" Margin="0,0,0,4" />
        <Canvas x:Name="Notes" Grid.Row="1" />
    </Grid>
</ContentControl>
