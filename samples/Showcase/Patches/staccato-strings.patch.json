{
  "format": "lunelle-patch/1",
  "name": "staccato-strings",
  "about": "Strings played short, off the string: the same saws, struck and gone, for a figure that drives a song along",
  "operators": [
    { "name": "saw1", "kind": "saw", "detune": -7, "envelope": "adsr 0.012 0.22 0.25 0.1", "level": 0.4 },
    { "name": "saw2", "kind": "saw", "detune": 6, "envelope": "adsr 0.012 0.22 0.25 0.1", "level": 0.4 },
    { "name": "saw3", "kind": "saw", "ratio": 2, "envelope": "adsr 0.012 0.22 0.25 0.1", "level": 0.12 }
  ],
  "out": [{ "op": "saw1", "pan": -0.5 }, { "op": "saw2", "pan": 0.5 }, { "op": "saw3" }],
  "filter": {
    "kind": "lowPass",
    "cutoff": 1800,
    "keyTrack": 0.4,
    "velocity": 0.3,
    "envelopeOctaves": 1.2,
    "envelope": "decay 0.15"
  },
  "gain": -6,
  "sends": { "space": 0.3 }
}
