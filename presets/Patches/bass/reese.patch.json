{
  "format": "lunelle-patch/1",
  "name": "reese",
  "about": "A reese: two saws far enough apart to grind against each other, with a square an octave below, driven, under a low-pass that each note pushes open and Bright opens three octaves more",
  "operators": [
    { "name": "saw1", "kind": "saw", "detune": -19, "envelope": "adsr 0.01 0.3 0.9 0.1", "level": 0.45 },
    { "name": "saw2", "kind": "saw", "detune": 18, "phase": 0.4, "envelope": "adsr 0.01 0.3 0.9 0.1", "level": 0.45 },
    { "name": "pulse1", "kind": "pulse", "ratio": 0.5, "envelope": "adsr 0.01 0.3 0.9 0.1", "level": 0.3 }
  ],
  "out": [{ "op": "saw1", "pan": -0.2 }, { "op": "saw2", "pan": 0.2 }, { "op": "pulse1" }],
  "filter": {
    "kind": "lowPass",
    "cutoff": 170,
    "q": 1.5,
    "keyTrack": 0.2,
    "envelopeOctaves": 1.2,
    "envelope": "adsr 0.02 0.35 0.3 0.1"
  },
  "drive": 0.45,
  "gain": -2,
  "mono": { "glide": 0.03 },
  "macros": [
    { "macro": 0, "target": "filterOctaves", "from": 0, "to": 3 },
    { "macro": 2, "target": "filterOctaves", "from": 0, "to": 2 }
  ]
}
