{
  "format": "lunelle-patch/1",
  "name": "warm-pad",
  "about": "A warm pad: four saws a few cents apart, each in its own place from left to right, slow to come and go, under a filter that opens as it swells",
  "operators": [
    { "name": "saw1", "kind": "saw", "detune": -9, "envelope": "adsr 0.7 0.5 0.85 1.4", "level": 0.3 },
    { "name": "saw2", "kind": "saw", "detune": -3, "envelope": "adsr 0.7 0.5 0.85 1.4", "level": 0.3 },
    { "name": "saw3", "kind": "saw", "detune": 4, "envelope": "adsr 0.7 0.5 0.85 1.4", "level": 0.3 },
    { "name": "saw4", "kind": "saw", "detune": 10, "envelope": "adsr 0.7 0.5 0.85 1.4", "level": 0.3 }
  ],
  "out": [
    { "op": "saw1", "pan": -0.7 },
    { "op": "saw2", "pan": 0.25 },
    { "op": "saw3", "pan": -0.25 },
    { "op": "saw4", "pan": 0.7 }
  ],
  "filter": { "kind": "lowPass", "cutoff": 1200, "keyTrack": 0.3, "envelopeOctaves": 0.8, "envelope": "adsr 1.2 1 0.6 1.5" },
  "gain": -8,
  "sends": { "space": 0.4 },
  "macros": [{ "macro": 0, "target": "filterCutoff", "from": 0.6, "to": 2 }]
}
