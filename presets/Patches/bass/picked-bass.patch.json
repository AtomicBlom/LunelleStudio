{
  "format": "lunelle-patch/1",
  "name": "picked-bass",
  "about": "A picked bass: a sine with a little feedback and a bright pick at the start of each note, gliding when notes overlap",
  "operators": [
    { "name": "modulator", "kind": "sine", "ratio": 3, "envelope": "decay 0.06", "level": 0.8, "velocity": 0.7 },
    {
      "name": "sine1",
      "kind": "sine",
      "envelope": "adsr 0.002 0.9 0.3 0.08",
      "feedback": 0.15,
      "modulatedBy": [{ "op": "modulator", "index": 2 }]
    }
  ],
  "out": [{ "op": "sine1" }],
  "drive": 0.2,
  "mono": {}
}
