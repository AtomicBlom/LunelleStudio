{
  "format": "lunelle-patch/1",
  "name": "pluck-lead",
  "about": "A plucked lead: a saw and a narrow pulse through a filter that snaps shut, for a riff or a run of sixteenths",
  "operators": [
    { "name": "saw1", "kind": "saw", "envelope": "adsr 0.002 0.22 0 0.1", "level": 0.5 },
    {
      "name": "pulse1",
      "kind": "pulse",
      "detune": 7,
      "envelope": "adsr 0.002 0.22 0 0.1",
      "level": 0.3,
      "pulseWidth": 0.25
    }
  ],
  "out": [{ "op": "saw1" }, { "op": "pulse1" }],
  "filter": {
    "kind": "lowPass",
    "cutoff": 500,
    "q": 1.6,
    "keyTrack": 0.5,
    "velocity": 0.3,
    "envelopeOctaves": 4,
    "envelope": "decay 0.12"
  },
  "gain": -3,
  "sends": { "space": 0.2, "echo": 0.35 },
  "macros": [{ "macro": 0, "target": "filterOctaves", "from": -1, "to": 1.5 }]
}
