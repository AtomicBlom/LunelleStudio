{
  "format": "lunelle-patch/1",
  "name": "horn",
  "about": "A horn: a carrier with a slower-opening modulator, so the note brightens as it swells",
  "operators": [
    { "name": "modulator", "kind": "sine", "envelope": "adsr 0.08 0.3 0.6 0.15" },
    {
      "name": "sine1",
      "kind": "sine",
      "envelope": "adsr 0.06 0.2 0.8 0.15",
      "level": 0.6,
      "modulatedBy": [{ "op": "modulator", "index": 1.8 }]
    }
  ],
  "out": [{ "op": "sine1" }],
  "filter": { "kind": "lowPass", "cutoff": 2500, "keyTrack": 0.5 },
  "sends": { "space": 0.35 },
  "vibrato": { "rate": 4.8, "depth": 0.08, "delay": 0.4 },
  "mono": { "glide": 0.03 }
}
