<?xml version="1.0" encoding="utf-8"?>
<!--
    Files: the project's music as files, each song's and patch's data and the C# that is theirs, down the left; the one
    chosen beside them as it is on disk, with Copy file and a button per piece to copy (a class or a member; a track, a
    section or a part; an operator).
-->
<ContentControl xmlns="https://github.com/AtomicBlom/SUIsei/ui"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:wb="using:Loom.Audio.Workbench"
                xmlns:views="using:Loom.Audio.Workbench.Views"
                x:Class="Loom.Audio.Workbench.Views.FilesView"
                IsTabStop="False">
    <Grid Margin="12,10,12,10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Margin="0,0,10,0" Background="{x:Static views:Theme.Panel}" BorderBrush="{x:Static views:Theme.Line}" BorderThickness="1" CornerRadius="8">
            <ScrollViewer>
                <ListView x:Name="FileList" Margin="4,6,12,6" ItemsSource="{x:Bind ViewModel.Files.Files, Mode=OneWay}" IsItemClickEnabled="True"
                          SelectedIndex="{x:Bind ViewModel.Files.ShownIndex, Mode=TwoWay}">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="wb:FileEntryViewModel">
                            <Grid ToolTipService.ToolTip="{x:Bind Path}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Path Data="{x:Bind views:Display.FileIcon(Name)}" Width="14" Height="14" Stretch="Uniform" Stroke="{x:Static views:Theme.Dim}"
                                      StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      VerticalAlignment="Center" Margin="0,0,8,0" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{x:Bind Name}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{x:Bind Kind}" FontSize="10" Foreground="{x:Static views:Theme.Dim}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </ScrollViewer>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
                <TextBlock Text="{x:Bind ViewModel.Files.Title, Mode=OneWay}" FontSize="13" Foreground="{x:Static views:Theme.Ink}"
                           VerticalAlignment="Center" Margin="0,0,12,0" TextTrimming="CharacterEllipsis" />
                <Button Command="{x:Bind ViewModel.Files.CopyFileCommand, Mode=OneWay}" Margin="0,0,10,0" Padding="8,2,8,3"
                        ToolTipService.ToolTip="Copy the whole file to the clipboard">
                    <TextBlock Text="Copy file" FontSize="12" />
                </Button>
                <TextBlock Text="{x:Bind ViewModel.CopyStatus, Mode=OneWay}" FontSize="11" Foreground="{x:Static views:Theme.Dim}" VerticalAlignment="Center" />
            </StackPanel>
            <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,0,0,8">
                <ItemsControl ItemsSource="{x:Bind ViewModel.Files.Pieces, Mode=OneWay}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="wb:FilePieceViewModel">
                            <Button Command="{x:Bind CopyCommand}" Margin="0,0,3,0" Padding="6,2,6,3" ToolTipService.ToolTip="Copy this piece of the file to the clipboard">
                                <TextBlock Text="{x:Bind Name}" FontSize="11" />
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <Border Grid.Row="2" Background="{x:Static views:Theme.Sunk}" CornerRadius="6">
                <ScrollViewer HorizontalScrollBarVisibility="Auto">
                    <TextBlock Text="{x:Bind ViewModel.Files.Text, Mode=OneWay}" FontSize="12" Foreground="{x:Static views:Theme.Ink}" Margin="10,8,10,8" />
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</ContentControl>
