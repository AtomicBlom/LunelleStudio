<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- What SirrowStudio takes as packages comes from nuget.org: the engine's, the audio's and SUIsei's released packages
       where a source is "none" (build/Sources.props), and everything else. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
