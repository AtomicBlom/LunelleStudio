<?xml version="1.0" encoding="utf-8"?>
<!-- Kit: the kit chosen, a pad per piece. The keyboard's keys play the pieces too. -->
<ContentControl xmlns="https://github.com/AtomicBlom/SUIsei/ui"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:wb="using:Loom.Audio.Workbench"
                xmlns:views="using:Loom.Audio.Workbench.Views"
                x:Class="Loom.Audio.Workbench.Views.KitView"
                IsTabStop="False">
    <StackPanel Margin="12,10,12,12">
        <TextBlock Text="{x:Bind ViewModel.DockLabel, Mode=OneWay}" FontSize="16" Foreground="{x:Static views:Theme.Ink}" Margin="0,0,0,10" />
        <TextBlock Text="Choose a kit from the library." FontSize="13" Foreground="{x:Static views:Theme.Dim}"
                   Visibility="{x:Bind views:Display.NoneChosen(ViewModel.SelectedKit), Mode=OneWay}" />
        <ScrollViewer HorizontalScrollMode="Enabled">
            <ItemsControl ItemsSource="{x:Bind ViewModel.Pads, Mode=OneWay}" Margin="0,0,0,14">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="wb:PadViewModel">
                        <Button Command="{x:Bind Hit}" Width="120" Height="96" Margin="0,0,8,0">
                            <TextBlock Text="{x:Bind Piece}" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </StackPanel>
</ContentControl>
