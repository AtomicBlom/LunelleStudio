{
  "format": "lunelle-patch/1",
  "name": "saw-lead",
  "about": "A lead: two saws and a pulse, sliding from note to note, bright as each note starts, into the echo",
  "operators": [
    { "name": "saw1", "kind": "saw", "detune": -9, "envelope": "adsr 0.006 0.2 0.75 0.14", "level": 0.4 },
    { "name": "saw2", "kind": "saw", "detune": 9, "phase": 0.3, "envelope": "adsr 0.006 0.2 0.75 0.14", "level": 0.4 },
    { "name": "pulse1", "kind": "pulse", "envelope": "adsr 0.006 0.2 0.75 0.14", "level": 0.2, "pulseWidth": 0.3 }
  ],
  "out": [{ "op": "saw1", "pan": -0.3 }, { "op": "saw2", "pan": 0.3 }, { "op": "pulse1" }],
  "filter": {
    "kind": "lowPass",
    "cutoff": 1800,
    "q": 1.2,
    "keyTrack": 0.5,
    "envelopeOctaves": 1.5,
    "envelope": "adsr 0.005 0.25 0.3 0.15"
  },
  "gain": -6,
  "sends": { "space": 0.15, "echo": 0.3 },
  "vibrato": { "rate": 5.8, "depth": 0.12, "delay": 0.25 },
  "mono": { "glide": 0.04 },
  "macros": [{ "macro": 0, "target": "filterOctaves", "from": -1, "to": 1.2 }]
}
