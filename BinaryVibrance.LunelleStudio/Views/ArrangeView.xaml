<?xml version="1.0" encoding="utf-8"?>
<!--
    Arrange: the song as a board. Across the top each section's head (its name, a ruler of its bars and chords, its exits),
    down the left each track's head (its hue, mute, solo, gain and meter); both stay put as the lanes under them scroll.
    Where a lane crosses a section, the parts the track plays there, every pass drawn across the section. A part is added
    from its cell's slot while the cell is empty, else from a part's or a track's menu; a track from the row under the last
    lane, a track's menu, or a patch or kit dropped from the library. Beside the board the inspector, for the section or
    part chosen; under it, past a splitter, the part chosen in the roll.
-->
<ContentControl xmlns="https://github.com/AtomicBlom/Vysara/ui"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:wb="using:BinaryVibrance.LunelleStudio"
                xmlns:views="using:BinaryVibrance.LunelleStudio.Views"
                xmlns:vysara="https://github.com/AtomicBlom/Vysara/extensions"
                x:Class="BinaryVibrance.LunelleStudio.Views.ArrangeView"
                IsTabStop="False">
    <ContentControl.Resources>
        <ResourceDictionary>
            <!-- A tool's glyph: drawn in a 16 square with round ends, as the rail's icons are -->
            <Style x:Key="Glyph" TargetType="Path">
                <Setter Property="Width" Value="16" />
                <Setter Property="Height" Value="16" />
                <Setter Property="Stroke" Value="{x:Static views:Theme.Ink}" />
                <Setter Property="StrokeThickness" Value="1.6" />
                <Setter Property="StrokeStartLineCap" Value="Round" />
                <Setter Property="StrokeEndLineCap" Value="Round" />
                <Setter Property="StrokeLineJoin" Value="Round" />
            </Style>
        </ResourceDictionary>
    </ContentControl.Resources>
    <Grid x:Name="Layout">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="6" />
            <RowDefinition Height="300" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- The inspector, the full height beside the board and the part, while something is chosen -->
        <Border Grid.Column="1" Grid.RowSpan="4" Width="320" Background="{x:Static views:Theme.Panel}" BorderBrush="{x:Static views:Theme.LineStrong}"
                BorderThickness="1,0,0,0" Visibility="{x:Bind views:Display.Shown(ViewModel.Inspected), Mode=OneWay}">
            <views:Inspector ViewModel="{x:Bind ViewModel, Mode=OneWay}" />
        </Border>

        <!-- The song and what plays next -->
        <Grid x:Name="Head" Grid.Row="0" Margin="12,8,12,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button Command="{x:Bind ViewModel.InspectSongCommand, Mode=OneWay}" Padding="8,2,10,3" VerticalAlignment="Center"
                    ToolTipService.ToolTip="Song settings: tempo, key and scale">
                <TextBlock Text="{x:Bind ViewModel.SongName, Mode=OneWay}" FontSize="16" Foreground="{x:Static views:Theme.Ink}" />
            </Button>
            <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.NextText, Mode=OneWay}" FontSize="13" Foreground="{x:Static views:Theme.Dim}"
                       Margin="16,0,0,0" VerticalAlignment="Center" />
        </Grid>

        <Grid Grid.Row="1">

            <!-- The board: the lanes scroll both ways; the heads drawn over them move back by as much, so they stay put -->
            <ScrollViewer x:Name="Lanes" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <!-- Under the last lane: a track added, playing a patch or kit chosen from a list -->
                    <Button x:Name="AddTrack" Grid.Row="2" Width="164" Margin="6,6,0,12" Padding="10,4,12,5" HorizontalAlignment="Left"
                            Background="{x:Static views:Theme.Clear}" BorderBrush="{x:Static views:Theme.Line}" BorderThickness="1"
                            ToolTipService.ToolTip="Add a track. You can also drag a patch or kit from the library onto the board.">
                        <TextBlock Text="+ Add track" FontSize="11.5" Foreground="{x:Static views:Theme.Faint}" />
                    </Button>
                    <ItemsControl Grid.Row="1" ItemsSource="{x:Bind ViewModel.Tracks, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="wb:TrackViewModel">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="176" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ItemsControl Grid.Column="1" ItemsSource="{x:Bind Cells}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="wb:LaneCellViewModel">
                                                <views:LaneCell Track="{x:Bind Track}" Cell="{x:Bind Self}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <views:TrackHeader Grid.Column="0" Track="{x:Bind Self}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="176" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ItemsControl Grid.Column="1" ItemsSource="{x:Bind ViewModel.Sections, Mode=OneWay}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="wb:SectionViewModel">
                                    <views:SectionHeader Section="{x:Bind Self}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                    <!-- The corner over both heads, as tall as a section's head (SectionHeader.Tall): taller, it made the row taller
                         and the heads, centred in it, left a strip at the top where the lanes showed as they scrolled -->
                    <Border x:Name="Corner" Grid.Row="0" Width="176" Height="{x:Static views:SectionHeader.Tall}" HorizontalAlignment="Left"
                            VerticalAlignment="Top" Background="{x:Static views:Theme.Panel}"
                            BorderBrush="{x:Static views:Theme.LineStrong}" BorderThickness="0,0,1,1">
                        <StackPanel Margin="12,10,8,5">
                            <TextBlock Text="SECTIONS" FontSize="10" Foreground="{x:Static views:Theme.Faint}" />
                            <TextBlock Text="Bars and chords" FontSize="10" Foreground="{x:Static views:Theme.Faint}" Margin="0,22,0,0" />
                            <TextBlock Text="Exits" FontSize="10" Foreground="{x:Static views:Theme.Faint}" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>
            </ScrollViewer>

        </Grid>

        <vysara:GridSplitter x:Name="Splitter" Grid.Row="2" ResizeDirection="Rows" MinimumTrackSize="120"
                             ToolTipService.ToolTip="Drag to resize the part editor" />

        <!-- The part chosen: set apart on its own ground, under a rule in the accent, its title in a bar of its own -->
        <Border Grid.Row="3" Background="{x:Static views:Theme.Sunk}" BorderBrush="{x:Static views:Theme.Accent}" BorderThickness="0,2,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Background="{x:Static views:Theme.Raised}" Padding="12,6,12,6">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="PART" FontSize="10" Foreground="{x:Static views:Theme.Faint}" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <TextBlock Text="{x:Bind ViewModel.Roll.Title, Mode=OneWay}" FontSize="13" Foreground="{x:Static views:Theme.Ink}" VerticalAlignment="Center" Margin="0,0,12,0" />
                        <TextBlock Text="{x:Bind ViewModel.Roll.Status, Mode=OneWay}" FontSize="11" Foreground="{x:Static views:Theme.Accent}" VerticalAlignment="Center"
                                   Visibility="{x:Bind ViewModel.Roll.IsEditable, Mode=OneWay}" />
                    </StackPanel>
                </Border>

                <!-- Nothing chosen, or a part that isn't data: said in the middle of the panel, never over the notes -->
                <StackPanel Grid.Row="1" Visibility="{x:Bind views:Display.Not(ViewModel.Roll.IsEditable), Mode=OneWay}" Margin="12,10,12,10">
                    <views:PatternView Pattern="{x:Bind ViewModel.Pattern, Mode=OneWay}" Visibility="{x:Bind ViewModel.Pattern.HasNotes, Mode=OneWay}" />
                    <TextBlock Text="{x:Bind ViewModel.Roll.Status, Mode=OneWay}" FontSize="12" Foreground="{x:Static views:Theme.Dim}"
                               HorizontalAlignment="Center" Margin="0,12,0,0" TextWrapping="Wrap" />
                    <Button Command="{x:Bind ViewModel.Roll.BringBackCommand, Mode=OneWay}" Visibility="{x:Bind ViewModel.Roll.CanBringBack, Mode=OneWay}"
                            HorizontalAlignment="Center" Margin="0,8,0,0" Padding="8,2,8,3"
                            ToolTipService.ToolTip="Convert this part from C# back to notation in the song file">
                        <TextBlock Text="Convert to notation" FontSize="12" />
                    </Button>
                </StackPanel>

                <Grid Grid.Row="1" Visibility="{x:Bind ViewModel.Roll.IsEditable, Mode=OneWay}" Margin="12,6,12,8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Margin="0,0,0,6">
                        <!-- The roll's tools as glyphs: a line's flat, natural, sharp and slide; accent and delete; a bar more or
                             fewer; undo, redo and revert; then ejecting, in words -->
                        <StackPanel Orientation="Horizontal">
                            <StackPanel Orientation="Horizontal" Margin="0,0,8,0" Visibility="{x:Bind ViewModel.Roll.IsLine, Mode=OneWay}">
                                <Button Command="{x:Bind ViewModel.Roll.FlatCommand, Mode=OneWay}" Padding="6,4,6,4" Margin="0,0,2,0" ToolTipService.ToolTip="Flat: lower the selected note a semitone">
                                    <Path Data="M6,2 L6,14 C9,13 12,11 11,9 C10.2,7.4 7.8,7.8 6,9.5" Style="{StaticResource Glyph}" />
                                </Button>
                                <Button Command="{x:Bind ViewModel.Roll.NaturalCommand, Mode=OneWay}" Padding="6,4,6,4" Margin="0,0,2,0" ToolTipService.ToolTip="Natural: return the selected note to the scale">
                                    <Path Data="M5,2 L5,11 M11,5 L11,14 M5,7 L11,5 M5,11 L11,9" Style="{StaticResource Glyph}" />
                                </Button>
                                <Button Command="{x:Bind ViewModel.Roll.SharpCommand, Mode=OneWay}" Padding="6,4,6,4" Margin="0,0,2,0" ToolTipService.ToolTip="Sharp: raise the selected note a semitone">
                                    <Path Data="M6,2 L6,14 M10,2 L10,14 M3,7 L13,5.5 M3,11 L13,9.5" Style="{StaticResource Glyph}" />
                                </Button>
                                <Button Command="{x:Bind ViewModel.Roll.SlideCommand, Mode=OneWay}" Padding="6,4,6,4" ToolTipService.ToolTip="Slide: glide from the selected note into the next">
                                    <Path Data="M2,12 C5,12 6,5 9,5 L14,5 M11.5,2.5 L14,5 L11.5,7.5" Style="{StaticResource Glyph}" />
                                </Button>
                            </StackPanel>
                            <Button Command="{x:Bind ViewModel.Roll.AccentCommand, Mode=OneWay}" Padding="6,4,6,4" Margin="0,0,2,0" ToolTipService.ToolTip="Accent: play the selected note louder">
                                <Path Data="M4,4 L12,8 L4,12" Style="{StaticResource Glyph}" />
                            </Button>
                            <Button Command="{x:Bind ViewModel.Roll.DeleteCommand, Mode=OneWay}" Padding="6,4,6,4" Margin="0,0,8,0" ToolTipService.ToolTip="Delete the selected note (Delete)">
                                <Path Data="M4,4 L12,12 M12,4 L4,12" Style="{StaticResource Glyph}" />
                            </Button>
                            <Button Command="{x:Bind ViewModel.Roll.AddBarCommand, Mode=OneWay}" Padding="6,4,6,4" Margin="0,0,2,0" ToolTipService.ToolTip="Add a bar to the end of the part">
                                <Path Data="M3,2 L3,14 M7,8 L14,8 M10.5,4.5 L10.5,11.5" Style="{StaticResource Glyph}" />
                            </Button>
                            <Button Command="{x:Bind ViewModel.Roll.RemoveBarCommand, Mode=OneWay}" Padding="6,4,6,4" Margin="0,0,8,0" ToolTipService.ToolTip="Remove the last bar of the part">
                                <Path Data="M3,2 L3,14 M7,8 L14,8" Style="{StaticResource Glyph}" />
                            </Button>
                            <Button Command="{x:Bind ViewModel.Roll.UndoCommand, Mode=OneWay}" IsEnabled="{x:Bind ViewModel.Roll.CanUndo, Mode=OneWay}" Padding="6,4,6,4" Margin="0,0,2,0"
                                    ToolTipService.ToolTip="Undo (Ctrl Z)">
                                <Path Data="M5,3.5 L2,6.5 L5,9.5 M2,6.5 L10,6.5 C12.5,6.5 14,8 14,10.25 C14,12.5 12.5,14 10,14 L7,14" Style="{StaticResource Glyph}"
                                      Opacity="{x:Bind views:Display.Used(ViewModel.Roll.CanUndo), Mode=OneWay}" />
                            </Button>
                            <Button Command="{x:Bind ViewModel.Roll.RedoCommand, Mode=OneWay}" IsEnabled="{x:Bind ViewModel.Roll.CanRedo, Mode=OneWay}" Padding="6,4,6,4" Margin="0,0,2,0"
                                    ToolTipService.ToolTip="Redo (Ctrl Y)">
                                <Path Data="M11,3.5 L14,6.5 L11,9.5 M14,6.5 L6,6.5 C3.5,6.5 2,8 2,10.25 C2,12.5 3.5,14 6,14 L9,14" Style="{StaticResource Glyph}"
                                      Opacity="{x:Bind views:Display.Used(ViewModel.Roll.CanRedo), Mode=OneWay}" />
                            </Button>
                            <Button Command="{x:Bind ViewModel.Roll.RevertCommand, Mode=OneWay}" Padding="6,4,6,4" Margin="0,0,8,0" ToolTipService.ToolTip="Revert the part to how it was when the song was opened">
                                <Path Data="M2.5,2.5 L2.5,6.5 L6.5,6.5 M3,6.5 C4,4 6,2.5 8.75,2.5 C11.75,2.5 14,5 14,8.25 C14,11.5 11.5,14 8.5,14 C6.5,14 4.75,13 3.75,11.5"
                                      Style="{StaticResource Glyph}" />
                            </Button>
                            <StackPanel Orientation="Horizontal" Visibility="{x:Bind ViewModel.Roll.CanEject, Mode=OneWay}">
                                <Button Command="{x:Bind ViewModel.Roll.EjectNotationCommand, Mode=OneWay}" Padding="9,4,9,5" Margin="0,0,2,0"
                                        ToolTipService.ToolTip="Convert the part's notes to C#, to generate them in code"><TextBlock Text="Convert notes to C#" FontSize="12" /></Button>
                                <Button Command="{x:Bind ViewModel.Roll.EjectPlacementCommand, Mode=OneWay}" Padding="9,4,9,5"
                                        ToolTipService.ToolTip="Convert the whole part to C#: its notes, condition and fill"><TextBlock Text="Convert part to C#" FontSize="12" /></Button>
                            </StackPanel>
                        </StackPanel>
                        <TextBlock Text="{x:Bind ViewModel.Roll.Hint, Mode=OneWay}" FontSize="11" Foreground="{x:Static views:Theme.Faint}" Margin="0,5,0,0" />
                    </StackPanel>
                    <views:RollEditor Grid.Row="1" Roll="{x:Bind ViewModel.Roll, Mode=OneWay}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</ContentControl>
