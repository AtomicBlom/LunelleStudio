<Project Sdk="Microsoft.NET.Sdk">

	<!--
		A music project to start from, and the one lunelle-studio's "new" makes: a song, eight patches and a kit, written in
		the workbench and played from it with nothing else: open it with lunelle-studio, as README.md says. Its music is files
		(lunelle.meta.json, Songs/, Patches/, Kits/, Cues/) that Lunelle's music generator makes into C# as it builds; what
		a file can't say (the catalog) is C# here.
	-->
	<PropertyGroup>
		<TargetFramework>net11.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<RootNamespace>HelloSynth</RootNamespace>
	</PropertyGroup>

	<ItemGroup>
		<LunelleReference Include="BinaryVibrance.Lunelle" Path="BinaryVibrance.Lunelle\BinaryVibrance.Lunelle.csproj" />
		<!-- From source only: the BinaryVibrance.Lunelle package carries the generator as its analyzer -->
		<LunelleReference Include="BinaryVibrance.Lunelle.Music.Generator" Path="BinaryVibrance.Lunelle.Music.Generator\BinaryVibrance.Lunelle.Music.Generator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" SourceOnly="true" />
	</ItemGroup>

	<!-- The music as data (lunelle.meta.json and its folders, and Lunelle's own sounds), handed to the generator: the
	     package's build props do it, and a build of Lunelle from source imports them -->
	<Import Project="$(LunelleSource)BinaryVibrance.Lunelle\build\BinaryVibrance.Lunelle.props" Condition="'$(LunelleFromSource)' == 'true'" />

</Project>
