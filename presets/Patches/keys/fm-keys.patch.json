{
  "format": "lunelle-patch/1",
  "name": "fm-keys",
  "about": "Soft, dark FM keys: a short strike at fourteen times the pitch bends a decaying sine, which bends a warm one that holds a little, under a low-pass that keeps them dim and a slow tremolo. Drenched in the room and a long echo",
  "operators": [
    { "name": "strike", "kind": "sine", "ratio": 14, "envelope": "decay 0.05", "velocity": 0.8, "keyLevel": -4 },
    { "name": "tine", "kind": "sine", "envelope": "adsr 0.003 2.4 0 0.4", "level": 0.4, "modulatedBy": [{ "op": "strike", "index": 0.5 }] },
    { "name": "bar", "kind": "sine", "envelope": "adsr 0.003 3 0.2 0.5", "modulatedBy": [{ "op": "tine", "index": 0.6 }] }
  ],
  "out": [{ "op": "bar" }],
  "filter": { "kind": "lowPass", "cutoff": 2200, "keyTrack": 0.4 },
  "gain": -4,
  "sends": { "space": 0.45, "echo": 0.3 },
  "tremolo": { "rate": 3.2, "depth": 0.2 }
}
