{
  "format": "lunelle-song/3",
  "cues": { "intensity": null, "mood": null },
  "about": "The tour: one song that arranges itself from two cues. Drag intensity from 0 to 1 and back. Low, it is a pad and bells (dawn); past 0.35 the beat and bass come in (pulse); past 0.7 it builds (rise), a riser and an airy supersaw swept up over a snare roll, and drops (lift); falling, it steps back down. Mood picks the bells' motif, each coming in only where its phrase starts, and in lift a Dark mood swaps the lead for a Phrygian line. Every pass of pulse and lift ends on one of three fills, shuffled. The bass ducks under the kick (the bass bus's duck keys on the breaks kit's kick), and the filters on the bass, chords, arp and lead open with intensity (their tracks' bright macro follows it).",
  "tempo": 122,
  "scale": "A minor",
  "voices": 48,
  "effects": {
    "space": [{ "fx": "reverb", "decaySeconds": 2.8 }],
    "echo": [{ "fx": "delay", "seconds": 0.369, "feedback": 0.4, "pingPong": true }]
  },
  "groups": [
    { "name": "drum bus", "effects": [{ "fx": "compressor", "thresholdDb": -16, "ratio": 3 }] },
    { "name": "bass bus", "effects": [{ "fx": "duck", "thresholdDb": -30, "ratio": 8, "attackSeconds": 0.002, "releaseSeconds": 0.12 }] },
    { "name": "wide", "effects": [{ "fx": "chorus", "mix": 0.35 }] }
  ],
  "variations": [{ "name": "fill", "options": 3, "pick": "shuffle" }],
  "tracks": [
