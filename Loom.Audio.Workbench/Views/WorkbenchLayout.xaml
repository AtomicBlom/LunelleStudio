<?xml version="1.0" encoding="utf-8"?>
<!--
    The workbench page: the transport across the top, the error under it when a song fails to build, the sections and
    the cues, the tracks and the patch bench, the chosen part as a grid, and the chip's load. Each region is a view of its
    own, handed the page's view model.
-->
<ContentControl xmlns="https://github.com/AtomicBlom/SUIsei/ui"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:views="using:Loom.Audio.Workbench.Views"
                x:Class="Loom.Audio.Workbench.Views.WorkbenchLayout"
                IsTabStop="False">
    <Grid MinWidth="960" MinHeight="600" Background="{x:Static views:Theme.Page}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="200" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <views:TransportBar x:Name="TransportView" Grid.Row="0" Margin="12,10,12,6" ViewModel="{x:Bind ViewModel}" />

        <Border Grid.Row="1" Margin="12,0,12,6" Padding="10,6,10,7" CornerRadius="6" Background="{x:Static views:Theme.Error}"
                Visibility="{x:Bind views:Display.Any(ViewModel.Error), Mode=OneWay}">
            <TextBlock Text="{x:Bind ViewModel.Error, Mode=OneWay}" FontSize="14" Foreground="#FFFFFF" TextWrapping="Wrap" />
        </Border>

        <Grid Grid.Row="2" Margin="12,0,12,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Margin="0,0,6,0" Padding="10,8" CornerRadius="8" Background="{x:Static views:Theme.Panel}">
                <views:SectionStrip ViewModel="{x:Bind ViewModel}" />
            </Border>
            <Border Grid.Column="1" Margin="6,0,0,0" Padding="10,8" CornerRadius="8" Background="{x:Static views:Theme.Panel}">
                <views:CuePanel ViewModel="{x:Bind ViewModel}" />
            </Border>
        </Grid>

        <Grid Grid.Row="3" Margin="12,0,12,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Margin="0,0,6,0" Padding="10,8" CornerRadius="8" Background="{x:Static views:Theme.Panel}">
                <views:TrackList ViewModel="{x:Bind ViewModel}" />
            </Border>
            <Border Grid.Column="1" Margin="6,0,0,0" Padding="10,8" CornerRadius="8" Background="{x:Static views:Theme.Panel}">
                <views:PatchBench ViewModel="{x:Bind ViewModel}" />
            </Border>
        </Grid>

        <Border Grid.Row="4" Margin="12,0,12,6" Padding="10,8" CornerRadius="8" Background="{x:Static views:Theme.Panel}">
            <views:PatternView Pattern="{x:Bind ViewModel.Pattern}" />
        </Border>

        <TextBlock Grid.Row="5" Text="{x:Bind ViewModel.StatsText, Mode=OneWay}" Margin="14,0,14,8" FontSize="13"
                   Foreground="{x:Static views:Theme.Dim}" />
    </Grid>
</ContentControl>
