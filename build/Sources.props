<Project>

  <!--
    Where the repositories SirrowStudio builds on come from: a checkout of each, built from source, or its packages.
    Directory.Build.props imports this; the workbench app imports it itself, before Loom's SDK, which needs it.

      LoomSource       The engine (Kaldra, still Loom's repository): a checkout, its folder ending in a slash. By default
                       ..\Kaldra\ beside this repository, where it is checked out. "none" takes its packages.
      SirrowSource     The audio: by default ..\Sirrow\, where it is checked out. "none" takes its packages.
      SUIseiSource     The UI library: by default the SUIsei submodule in the engine's checkout. "none" takes its package.
      LoomPackageVersion, SirrowPackageVersion
                       The packages' versions, where a source is "none". SUIsei's is the engine's (LoomSUIseiVersion).

    A machine's own choices go in dev.local.props at this repository's root (untracked, as every *.local.props is):

      <Project>
        <PropertyGroup>
          <SirrowSource>none</SirrowSource>
          <SirrowPackageVersion>0.1.0</SirrowPackageVersion>
        </PropertyGroup>
      </Project>

    or on the command line, as -p:LoomSource=none. build/Sources.targets turns each LoomReference, SirrowReference and
    SUIseiReference into a reference to the checkout's project or to the package.
  -->
  <PropertyGroup Condition="'$(_StudioSourcesProps)' == ''">
    <_StudioSourcesProps>true</_StudioSourcesProps>
    <_StudioRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\'))</_StudioRoot>
    <_StudioSiblings>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..\'))</_StudioSiblings>
  </PropertyGroup>

  <Import Project="$(_StudioRoot)dev.local.props" Condition="Exists('$(_StudioRoot)dev.local.props') and '$(_StudioDevLocal)' == ''" />

  <PropertyGroup>
    <_StudioDevLocal>true</_StudioDevLocal>

    <LoomSource Condition="'$(LoomSource)' == '' and Exists('$(_StudioSiblings)Kaldra\Loom.Core\Loom.Core.csproj')">$(_StudioSiblings)Kaldra\</LoomSource>
    <LoomSource Condition="'$(LoomSource)' == ''">none</LoomSource>
    <LoomSource Condition="'$(LoomSource)' != 'none' and !HasTrailingSlash('$(LoomSource)')">$(LoomSource)\</LoomSource>
    <LoomFromSource Condition="'$(LoomSource)' != 'none'">true</LoomFromSource>

    <SirrowSource Condition="'$(SirrowSource)' == '' and Exists('$(_StudioSiblings)Sirrow\Loom.Audio\Loom.Audio.csproj')">$(_StudioSiblings)Sirrow\</SirrowSource>
    <SirrowSource Condition="'$(SirrowSource)' == ''">none</SirrowSource>
    <SirrowSource Condition="'$(SirrowSource)' != 'none' and !HasTrailingSlash('$(SirrowSource)')">$(SirrowSource)\</SirrowSource>
    <SirrowFromSource Condition="'$(SirrowSource)' != 'none'">true</SirrowFromSource>

    <SUIseiSource Condition="'$(SUIseiSource)' == '' and '$(LoomFromSource)' == 'true' and Exists('$(LoomSource)external\SUIsei\SUIsei\SUIsei.csproj')">$(LoomSource)external\SUIsei\</SUIseiSource>
    <SUIseiSource Condition="'$(SUIseiSource)' == ''">none</SUIseiSource>
    <SUIseiSource Condition="'$(SUIseiSource)' != 'none' and !HasTrailingSlash('$(SUIseiSource)')">$(SUIseiSource)\</SUIseiSource>
    <SUIseiFromSource Condition="'$(SUIseiSource)' != 'none'">true</SUIseiFromSource>

    <LoomPackageVersion Condition="'$(LoomPackageVersion)' == ''">0.1.0-preview.1</LoomPackageVersion>
    <SirrowPackageVersion Condition="'$(SirrowPackageVersion)' == ''">0.1.0-preview.1</SirrowPackageVersion>
    <!-- Read by Loom's SDK for the SUIsei package an app with UseSUIsei takes; made at the engine's version -->
    <LoomSUIseiVersion Condition="'$(LoomSUIseiVersion)' == ''">$(LoomPackageVersion)</LoomSUIseiVersion>
  </PropertyGroup>

</Project>
