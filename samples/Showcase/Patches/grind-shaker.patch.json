{
  "format": "lunelle-patch/1",
  "name": "grind-shaker",
  "about": "A shaker: a quick swell and fall of noise in a band round 6 kHz",
  "operators": [{ "name": "beans", "kind": "noise", "envelope": "adsr 0.008 0.06 0 0.03", "level": 0.9 }],
  "out": [{ "op": "beans" }],
  "filter": { "kind": "bandPass", "cutoff": 6000, "q": 1.4 },
  "gain": -1,
  "sends": { "space": 0.1 }
}
